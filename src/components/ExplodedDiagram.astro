---
// ExplodedDiagram — interactive exploded-view illustration with clickable hotspots.
// Mobile-first: the wide diagram scrolls horizontally on small screens (labels stay
// legible) and taps open a fullscreen lightbox. Hotspots and the accordion cards are
// one bidirectional flow — tapping either side highlights and reveals the other.
interface Hotspot {
	id: string;
	label: string;
	note: string;
	x: number;            // % of diagram width (0–100)
	y: number;            // % of diagram height (0–100)
	href?: string;
	hrefLabel?: string;
	external?: boolean;
}
interface Props {
	title?: string;
	image: string;
	imageAlt: string;
	aspectRatio: number;  // width / height — reserves space, zero CLS
	hotspots: Hotspot[];
	caption?: string;
	cta?: { text: string; href: string; label: string; external?: boolean };
	mode?: 'standalone' | 'embed';
}
const { title, image, imageAlt, aspectRatio, hotspots, caption, cta, mode = 'standalone' } = Astro.props;
const showTitle = mode === 'standalone' && title;
---

<div class="exploded" data-exploded>
	{showTitle && <h2 class="exploded-title">{title}</h2>}

	<div class="exploded-figure-wrap">
		<figure class="exploded-figure" style={`aspect-ratio: ${aspectRatio};`}>
			<img
				class="exploded-img"
				src={image}
				alt={imageAlt}
				loading={mode === 'standalone' ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={mode === 'standalone' ? 'high' : undefined}
			/>
			{hotspots.map((h, i) => (
				<button
					class="hotspot"
					type="button"
					style={`left: ${h.x}%; top: ${h.y}%;`}
					data-hotspot={i}
					aria-label={`${i + 1}. ${h.label}`}
					aria-controls={`part-${h.id}`}
					aria-expanded="false"
				>
					<span class="hotspot-pulse" aria-hidden="true"></span>
					<span class="hotspot-dot" aria-hidden="true"></span>
				</button>
			))}
			<button class="expand-btn" type="button" data-expand aria-label="Enlarge diagram">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9 3H5a2 2 0 0 0-2 2v4h2V5h4V3zm6 0h4a2 2 0 0 1 2 2v4h-2V5h-4V3zM3 15v4a2 2 0 0 0 2 2h4v-2H5v-4H3zm16 0v4a2 2 0 0 1-2 2h-4v-2h4v-4h2z"/></svg>
			</button>
		</figure>
		<div class="swipe-hint" aria-hidden="true">Swipe to explore →</div>
	</div>

	{caption && <figcaption class="exploded-caption">{caption}</figcaption>}

	<ol class="parts">
		{hotspots.map((h, i) => (
			<li>
				<details class="part" id={`part-${h.id}`} data-part={i}>
					<summary>
						<span class="part-num" aria-hidden="true">{i + 1}</span>
						<span class="part-label">{h.label}</span>
					</summary>
					<div class="part-body">
						<p>{h.note}</p>
						{h.href && (
							<a
								class="part-link"
								href={h.href}
								{...(h.external ? { target: '_blank', rel: 'nofollow sponsored noopener' } : {})}
							>
								{h.hrefLabel || 'Read more →'}
							</a>
						)}
					</div>
				</details>
			</li>
		))}
	</ol>

	{cta && (
		<div class="exploded-cta">
			<p>{cta.text}</p>
			<a
				href={cta.href}
				class="exploded-cta-btn"
				{...(cta.external ? { target: '_blank', rel: 'nofollow sponsored noopener' } : {})}
			>{cta.label}</a>
		</div>
	)}

	{/* Fullscreen lightbox */}
	<div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label={imageAlt}>
		<div class="lightbox-backdrop" data-close></div>
		<div class="lightbox-content">
			<button class="lightbox-close" type="button" data-close aria-label="Close">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3 1.4 1.4z"/></svg>
			</button>
			<img class="lightbox-img" src={image} alt={imageAlt} />
		</div>
	</div>
</div>

<script>
	// Wire hotspots <-> accordion cards into one bidirectional flow, add a lightbox,
	// horizontal-scroll reveal, and teach the interaction by opening step 1 on view.
	(function () {
		const roots = document.querySelectorAll('[data-exploded]');
		if (!roots.length) return;

		roots.forEach((root) => {
			const hotspots = Array.from(root.querySelectorAll('[data-hotspot]'));
			const parts = Array.from(root.querySelectorAll('[data-part]'));
			const wrap = root.querySelector('.exploded-figure-wrap');
			const img = root.querySelector('.exploded-img');
			const expandBtn = root.querySelector('[data-expand]');
			const lightbox = root.querySelector('[data-lightbox]');
			const lightboxImg = root.querySelector('.lightbox-img');
			if (!hotspots.length || !parts.length) return;

			const setActive = (index, { scrollCard = true, scrollHotspot = false } = {}) => {
				parts.forEach((p, j) => {
					if (j === index) p.setAttribute('open', '');
					else p.removeAttribute('open');
				});
				hotspots.forEach((hs, j) => {
					hs.classList.toggle('is-active', j === index);
					hs.setAttribute('aria-expanded', String(j === index));
				});
				if (scrollCard) {
					parts[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}
				if (scrollHotspot) {
					hotspots[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
				}
			};

			// Hotspot click -> open the matching card + reveal it
			hotspots.forEach((hs, i) => {
				hs.addEventListener('click', () => setActive(i, { scrollCard: true }));
			});

			// Card open -> highlight + reveal the matching hotspot
			parts.forEach((p, i) => {
				p.addEventListener('toggle', () => {
					if (p.open) {
						hotspots.forEach((hs, j) => {
							hs.classList.toggle('is-active', j === i);
							hs.setAttribute('aria-expanded', String(j === i));
						});
						hotspots[i]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
					}
				});
			});

			// Lightbox: expand button or tap on the image opens a fullscreen, scrollable view
			const openLightbox = () => {
				if (!lightbox) return;
				if (lightboxImg && img) lightboxImg.src = img.getAttribute('src') || img.src;
				lightbox.hidden = false;
				document.body.style.overflow = 'hidden';
			};
			const closeLightbox = () => {
				if (!lightbox) return;
				lightbox.hidden = true;
				document.body.style.overflow = '';
			};
			if (expandBtn) expandBtn.addEventListener('click', openLightbox);
			if (img) img.addEventListener('click', openLightbox);
			if (lightbox) {
				lightbox.querySelectorAll('[data-close]').forEach((el) => {
					el.addEventListener('click', closeLightbox);
				});
				lightbox.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') closeLightbox();
				});
			}

			// Teach the interaction: the first time the diagram scrolls into view,
			// open step 1 and highlight its hotspot.
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								setActive(0, { scrollCard: false });
								io.disconnect();
							}
						});
					},
					{ threshold: 0.25 }
				);
				io.observe(root);
			}
		});
	})();
</script>

<style>
	.exploded { margin: 2em 0; }

	.exploded-title {
		font-size: 1.4rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0 0 1em;
		line-height: 1.3;
	}

	/* Figure: visual anchor with primary-color accent + soft elevation */
	.exploded-figure-wrap {
		position: relative;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		border-radius: 12px;
		box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
		border: 1px solid #e2e8f0;
		border-top: 3px solid #f97316;
		background: #f8fafc;
	}
	.exploded-figure {
		position: relative;
		width: 100%;
		margin: 0;
	}
	/* On narrow screens the diagram renders wider than the viewport and scrolls,
	   keeping its labels legible instead of shrinking them into unreadable text. */
	.exploded-figure { min-width: 720px; }
	@media (min-width: 920px) {
		.exploded-figure { min-width: 0; }
	}
	.exploded-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		cursor: zoom-in;
	}

	.swipe-hint {
		display: none;
		position: sticky;
		left: 0;
		bottom: 0;
		width: fit-content;
		margin: 0;
		padding: 6px 12px;
		background: rgba(15, 23, 42, 0.85);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		border-radius: 8px 8px 0 0;
		white-space: nowrap;
	}
	@media (max-width: 919px) {
		.swipe-hint { display: block; }
	}

	/* Expand button (corner) */
	.expand-btn {
		position: absolute;
		top: 10px;
		right: 10px;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		border: 1px solid #e2e8f0;
		background: rgba(255, 255, 255, 0.95);
		color: #0f172a;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
		transition: background 0.15s, transform 0.1s;
	}
	.expand-btn:hover {
		background: #fff;
		transform: scale(1.05);
	}

	/* Hotspots */
	.hotspot {
		position: absolute;
		width: 44px;
		height: 44px;
		margin: -22px 0 0 -22px; /* centre on the (x%, y%) point */
		padding: 0;
		background: transparent;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.hotspot-dot {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: #f97316;
		border: 3px solid #fff;
		box-shadow: 0 0 0 2px rgba(249, 115, 22, 0.45);
	}
	.hotspot-pulse {
		position: absolute;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: rgba(249, 115, 22, 0.5);
		animation: hotspot-pulse 2.2s ease-out infinite;
	}
	.hotspot:hover .hotspot-dot,
	.hotspot:focus-visible .hotspot-dot,
	.hotspot.is-active .hotspot-dot {
		background: #c2410c;
		transform: scale(1.25);
	}
	.hotspot.is-active .hotspot-pulse { display: none; }

	@keyframes hotspot-pulse {
		0%   { transform: scale(1); opacity: 0.7; }
		70%  { transform: scale(2.4); opacity: 0; }
		100% { transform: scale(2.4); opacity: 0; }
	}

	.exploded-caption {
		margin: 0.7em 0 0;
		font-size: 0.85rem;
		color: #64748b;
		text-align: left;
		line-height: 1.5;
		max-width: 60ch;
	}

	/* Parts list — single-column timeline with connecting rail (sequence) */
	.parts {
		list-style: none;
		margin: 1.4em 0 0;
		padding: 0;
		position: relative;
	}
	.parts > li {
		position: relative;
		padding-left: 34px;
		margin: 0 0 12px;
	}
	/* connecting vertical line between the number badges */
	.parts > li::before {
		content: '';
		position: absolute;
		left: 11px;
		top: 26px;
		bottom: -12px;
		width: 2px;
		background: #e2e8f0;
	}
	.parts > li:last-child::before { display: none; }
	.parts > li:first-child::before { background: linear-gradient(#f97316, #e2e8f0); }

	.part {
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		overflow: hidden;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.part:hover { box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08); }
	.part[open] {
		border-color: #f97316;
		box-shadow: 0 6px 20px rgba(249, 115, 22, 0.14);
	}
	.part summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 13px 14px;
		font-weight: 700;
		color: #0f172a;
		user-select: none;
	}
	.part summary::-webkit-details-marker { display: none; }
	.part-num {
		flex-shrink: 0;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: #f97316;
		color: #fff;
		font-size: 0.8rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 0 3px #fff;
	}
	.part[open] .part-num { background: #c2410c; }
	.part-label { flex: 1; font-size: 0.98rem; }
	/* chevron */
	.part summary::after {
		content: '';
		flex-shrink: 0;
		width: 8px;
		height: 8px;
		border-right: 2px solid #94a3b8;
		border-bottom: 2px solid #94a3b8;
		transform: rotate(45deg);
		transition: transform 0.2s;
	}
	.part[open] summary::after { transform: rotate(-135deg); border-color: #f97316; }
	.part-body {
		padding: 0 14px 14px;
	}
	.part-body p {
		margin: 0 0 10px;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #475569;
	}
	.part-link {
		font-size: 0.88rem;
		font-weight: 700;
		color: #f97316;
		text-decoration: none;
	}
	.part-link:hover { text-decoration: underline; }

	/* CTA strip */
	.exploded-cta {
		margin-top: 1.5em;
		background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
		border-radius: 12px;
		padding: 24px;
		text-align: center;
		color: #fff;
	}
	.exploded-cta p {
		margin: 0 0 16px;
		font-size: 0.92rem;
		opacity: 0.95;
		line-height: 1.5;
	}
	.exploded-cta-btn {
		display: inline-block;
		background: #fff;
		color: #ea580c;
		font-weight: 800;
		font-size: 0.95rem;
		padding: 11px 26px;
		border-radius: 8px;
		text-decoration: none;
		transition: transform 0.1s, box-shadow 0.1s;
	}
	.exploded-cta-btn:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
	}

	/* Lightbox */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 16px;
	}
	.lightbox[hidden] { display: none; }
	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 23, 42, 0.88);
	}
	.lightbox-content {
		position: relative;
		max-width: 96vw;
		max-height: 92vh;
		overflow: auto;
		background: #f8fafc;
		border-radius: 12px;
		padding: 10px;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
	}
	.lightbox-close {
		position: absolute;
		top: 10px;
		right: 10px;
		z-index: 2;
		width: 40px;
		height: 40px;
		border-radius: 8px;
		border: none;
		background: #0f172a;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.lightbox-img {
		display: block;
		width: 100%;
		height: auto;
		min-width: 900px;
	}
	@media (max-width: 919px) {
		.lightbox { padding: 8px; }
	}
</style>
