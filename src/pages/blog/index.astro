---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const CATEGORIES = ['All', 'ServiceM8', 'Solar & Battery', 'Compliance', 'Grid Connection', 'Business Growth', 'Software Comparisons'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description="Compliance guides, job management tips, and growth strategies for Australian solar & electrical installers." />
		<style>
			main {
				width: 960px;
			}
			.blog-header {
				margin-bottom: 2rem;
			}
			.blog-header h1 {
				font-size: 2em;
				margin-bottom: 0.25em;
			}
			.blog-header p {
				color: rgb(var(--gray));
				margin: 0 0 1.5rem 0;
			}

			/* ── Category filter pills ── */
			.category-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2rem;
			}
			.filter-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				padding: 0.4em 1em;
				border-radius: 999px;
				border: 1.5px solid rgb(var(--gray-light));
				background: white;
				color: rgb(var(--gray-dark));
				font-size: 0.875rem;
				font-weight: 500;
				cursor: pointer;
				transition: background 0.15s, border-color 0.15s, color 0.15s;
				user-select: none;
				line-height: 1;
			}
			.filter-pill:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.filter-pill.active {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
			}
			.filter-pill .count {
				background: rgba(255,255,255,0.25);
				border-radius: 999px;
				padding: 0.1em 0.45em;
				font-size: 0.78em;
				font-weight: 600;
			}
			.filter-pill:not(.active) .count {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray));
			}

			/* ── Post grid ── */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
			}
			ul li:first-child img {
				width: 100%;
				height: 360px;
			}
			ul li:first-child .title {
				font-size: 1.8rem;
			}
			ul li img {
				width: 100%;
				height: 200px;
				object-fit: cover;
				object-position: center;
				margin-bottom: 0.75rem;
				border-radius: 10px;
				display: block;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			.title {
				margin: 0 0 0.25em 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 1.1rem;
				font-weight: 700;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			ul li a:hover .title {
				color: var(--accent);
			}
			ul li a:hover img {
				box-shadow: var(--box-shadow);
				opacity: 0.92;
			}
			.no-image-card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1.25em;
				height: 100%;
				box-sizing: border-box;
				transition: box-shadow 0.2s, border-color 0.2s;
			}
			ul li a:hover .no-image-card {
				box-shadow: 0 4px 16px rgba(0,0,0,0.08);
				border-color: var(--accent);
			}

			/* Hidden state for filtered posts */
			ul li[data-hidden="true"] {
				display: none;
			}

			/* Re-apply first-child full-width when first visible item changes */
			ul li.is-first-visible {
				width: 100% !important;
				margin-bottom: 1rem;
			}
			ul li.is-first-visible img {
				height: 360px !important;
			}
			ul li.is-first-visible .title {
				font-size: 1.8rem !important;
			}

			/* No results */
			.no-results {
				display: none;
				padding: 3rem 0;
				text-align: center;
				color: rgb(var(--gray));
				font-size: 1.1rem;
			}
			.no-results.visible {
				display: block;
			}

			@media (max-width: 720px) {
				ul {
					gap: 1em;
				}
				ul li,
				ul li:first-child,
				ul li.is-first-visible {
					width: 100% !important;
					margin-bottom: 0;
				}
				ul li:first-child .title,
				ul li.is-first-visible .title {
					font-size: 1.4rem !important;
				}
				ul li:first-child img,
				ul li.is-first-visible img {
					height: 220px !important;
				}
				.category-filters {
					gap: 0.4rem;
				}
				.filter-pill {
					font-size: 0.8rem;
					padding: 0.35em 0.8em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-header">
				<h1>Blog</h1>
				<p>Compliance guides, job management tips, and growth strategies for Australian solar & electrical installers.</p>
			</div>

			<!-- Category filter pills -->
			<div class="category-filters" role="group" aria-label="Filter posts by category">
				{CATEGORIES.map((cat) => {
					const count = cat === 'All'
						? posts.length
						: posts.filter(p => p.data.category === cat).length;
					return (
						<button
							class={`filter-pill${cat === 'All' ? ' active' : ''}`}
							data-category={cat}
							aria-pressed={cat === 'All' ? 'true' : 'false'}
						>
							{cat}
							<span class="count">{count}</span>
						</button>
					);
				})}
			</div>

			<section>
				<ul id="post-grid">
					{
						posts.map((post, idx) => (
							<li data-category={post.data.category ?? 'Uncategorised'}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage ? (
										<picture>
											<source srcset={post.data.heroImage.replace(/\.(jpg|jpeg|png)$/i, '.webp')} type="image/webp" />
											<img
												src={post.data.heroImage}
												alt={post.data.title}
												loading={idx === 0 ? 'eager' : 'lazy'}
												fetchpriority={idx === 0 ? 'high' : 'auto'}
												decoding={idx === 0 ? 'sync' : 'async'}
												width="662"
												height="441"
											/>
										</picture>
									) : (
										<div class="no-image-card">
											<p class="title">{post.data.title}</p>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									)}
									{post.data.heroImage && (
										<>
											<p class="title">{post.data.title}</p>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</>
									)}
								</a>
							</li>
						))
					}
				</ul>
				<p class="no-results" id="no-results">No posts found in this category.</p>
			</section>
		</main>
		<Footer />

		<script>
			const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
			const grid = document.getElementById('post-grid')!;
			const noResults = document.getElementById('no-results')!;

			function applyFilter(selectedCategory: string) {
				const items = grid.querySelectorAll<HTMLLIElement>('li');
				let visibleCount = 0;

				items.forEach(item => {
					const cat = item.dataset.category ?? '';
					const show = selectedCategory === 'All' || cat === selectedCategory;
					item.dataset.hidden = show ? 'false' : 'true';
					item.classList.remove('is-first-visible');
					if (show) visibleCount++;
				});

				// Mark the first visible item so CSS can style it full-width
				const firstVisible = grid.querySelector<HTMLLIElement>('li[data-hidden="false"]');
				if (firstVisible) firstVisible.classList.add('is-first-visible');

				noResults.classList.toggle('visible', visibleCount === 0);

				// Update pill states
				pills.forEach(pill => {
					const active = pill.dataset.category === selectedCategory;
					pill.classList.toggle('active', active);
					pill.setAttribute('aria-pressed', active ? 'true' : 'false');
				});

				// Persist selection in URL hash (no page reload)
				history.replaceState(null, '', selectedCategory === 'All' ? '#' : `#${encodeURIComponent(selectedCategory)}`);
			}

			// Wire up pill clicks
			pills.forEach(pill => {
				pill.addEventListener('click', () => {
					applyFilter(pill.dataset.category ?? 'All');
				});
			});

			// Restore from URL hash on load
			const hash = decodeURIComponent(window.location.hash.slice(1));
			if (hash) {
				applyFilter(hash);
			} else {
				// Ensure first item gets first-visible class on initial load
				const firstItem = grid.querySelector<HTMLLIElement>('li');
				if (firstItem) firstItem.classList.add('is-first-visible');
			}
		</script>
	</body>
</html>
