---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const title = "You're subscribed — The TradieAutomate Field Note";
const description = 'Welcome to the weekly field note. Check your inbox for a confirmation email.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main style="max-width:640px;margin:0 auto;padding:60px 24px 80px;text-align:center;">
      <h1 style="font-size:clamp(1.6rem,4vw,2.2rem);font-weight:800;color:#0f172a;margin-bottom:12px;">
        You're in.
      </h1>
      <p style="font-size:1.05rem;color:#475569;line-height:1.6;margin-bottom:8px;">
        Check your inbox for a confirmation email.
      </p>
      <p style="font-size:0.9rem;color:#64748b;">
        If it's not there in 2 minutes, check spam — sometimes we end up there.
      </p>
      <p style="margin-top:28px;">
        <a href="/" style="color:#f97316;font-weight:700;text-decoration:none;">← Back to tradieautomate.com</a>
      </p>
    </main>
    <Footer />
  </body>
</html>
