            <div class="lib-qa">
              <button class="lib-qa-btn" aria-expanded="false" aria-controls="qa-5-3" data-prompt="How do I take a deposit from a solar customer using Stripe through ServiceM8?">
                How do I take a deposit from a customer using ServiceM8 + Stripe?
                <svg class="lib-qa-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
