    <script>
      // ── Chat logic ──
      const messagesEl = document.getElementById('chat-messages');
      const inputEl = document.getElementById('chat-input');
      const sendBtn = document.getElementById('send-btn');
      const startersEl = document.getElementById('starter-prompts');
      let history = [];
      let startersShown = true;

      // Auto-resize textarea
      inputEl.addEventListener('input', () => {
        inputEl.style.height = 'auto';
        inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
        sendBtn.disabled = inputEl.value.trim().length === 0;
      });

      // Send on Enter (Shift+Enter = newline)
      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (!sendBtn.disabled) sendMessage();
        }
      });

      sendBtn.addEventListener('click', sendMessage);

      // Starter prompt buttons
      document.querySelectorAll('.starter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          inputEl.value = btn.dataset.prompt;
          inputEl.style.height = 'auto';
          inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
          sendBtn.disabled = false;
          sendMessage();
        });
      });

      function appendMessage(role, content) {
        if (startersShown) {
          startersEl.style.display = 'none';
          startersShown = false;
        }
        const div = document.createElement('div');
        div.className = `msg ${role}`;
        div.innerHTML = `
          <div class="msg-avatar">${role === 'ai' ? '🧠' : '👷'}</div>
          <div class="msg-bubble">${formatMessage(content)}</div>
        `;
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return div;
      }

      function showTyping() {
        const div = document.createElement('div');
        div.className = 'msg ai';
        div.id = 'typing-indicator';
        div.innerHTML = `
          <div class="msg-avatar">🧠</div>
          <div class="typing-indicator"><span></span><span></span><span></span></div>
        `;
        messagesEl.appendChild(div);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }

      function removeTyping() {
        const el = document.getElementById('typing-indicator');
        if (el) el.remove();
      }

      function formatMessage(text) {
        // Convert markdown-style formatting to HTML
        return text
          .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
          .replace(/\*(.*?)\*/g, '<em>$1</em>')
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/^### (.+)$/gm, '<strong>$1</strong>')
          .replace(/^## (.+)$/gm, '<strong>$1</strong>')
          .replace(/^# (.+)$/gm, '<strong>$1</strong>')
          .split('\n\n').map(para => {
            if (para.match(/^[\-\*] /m)) {
              const items = para.split('\n').filter(l => l.trim()).map(l => `<li>${l.replace(/^[\-\*] /, '')}</li>`).join('');
              return `<ul>${items}</ul>`;
            }
            if (para.match(/^\d+\. /m)) {
              const items = para.split('\n').filter(l => l.trim()).map(l => `<li>${l.replace(/^\d+\. /, '')}</li>`).join('');
              return `<ol>${items}</ol>`;
            }
            return para ? `<p>${para.replace(/\n/g, '<br>')}</p>` : '';
          }).join('');
      }

      async function sendMessage() {
        const text = inputEl.value.trim();
        if (!text) return;

        // Clear input
        inputEl.value = '';
        inputEl.style.height = 'auto';
        sendBtn.disabled = true;

        // Show user message
        appendMessage('user', text);

        // Show typing indicator
        showTyping();
        sendBtn.disabled = true;

        try {
          const res = await fetch('/.netlify/functions/tradie-brain-chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, history }),
          });

          removeTyping();

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            appendMessage('ai', err.error || 'Something went wrong. Please try again.');
            return;
          }

          const data = await res.json();
          const reply = data.reply || 'Sorry, I could not generate a response. Please try again.';

          appendMessage('ai', reply);

          // Update history for context
          history.push({ role: 'user', content: text });
          history.push({ role: 'assistant', content: reply });
          if (history.length > 20) history = history.slice(-20);

        } catch (err) {
          removeTyping();
          appendMessage('ai', 'Connection error. Please check your internet connection and try again.');
        }
      }

      // ── Q&A Library — category toggles ──
      document.querySelectorAll('.lib-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          const body = document.getElementById(btn.getAttribute('aria-controls'));
          if (body) body.classList.toggle('open', !expanded);
        });
      });

      // ── Q&A Library — individual item accordions ──
      document.querySelectorAll('.lib-qa-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          const body = document.getElementById(btn.getAttribute('aria-controls'));
          if (body) body.classList.toggle('open', !expanded);
        });
      });

      // ── "Ask Tradie Brain" buttons — pre-fill chat and scroll up ──
      document.querySelectorAll('.lib-ask-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const prompt = btn.dataset.prompt;
          if (!prompt) return;
          inputEl.value = prompt;
          inputEl.style.height = 'auto';
          inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
          sendBtn.disabled = false;
          // Scroll to chat
          const chatWrap = document.getElementById('chat-container');
          if (chatWrap) {
            chatWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
            setTimeout(() => inputEl.focus(), 400);
          }
        });
      });

      // ── FAQ accordion ──
      document.querySelectorAll('.faq-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          const body = document.getElementById(btn.getAttribute('aria-controls'));
          if (body) body.classList.toggle('open', !expanded);
        });
      });

      // ── Disclaimer toggle ──
      const disclaimerBtn = document.getElementById('disclaimer-toggle');
      const disclaimerBody = document.getElementById('disclaimer-body');
      if (disclaimerBtn && disclaimerBody) {
        disclaimerBtn.addEventListener('click', () => {
          const open = disclaimerBody.classList.toggle('open');
          disclaimerBtn.setAttribute('aria-expanded', String(open));
          disclaimerBtn.textContent = (open ? '− ' : '+ ') + 'Data sources & disclaimer';
        });
      }
    </script>
  </body>
</html>
