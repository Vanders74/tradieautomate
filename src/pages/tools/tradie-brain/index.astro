---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE } from '../../../consts';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Tradie Brain AI",
  "url": "https://tradieautomate.com/tools/tradie-brain/",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "AUD"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  },
  "description": "Free AI advisor for Australian solar and electrical contractors. Instant answers on CER audits, AS/NZS 5033 and 5139, ServiceM8, STC claims, CCEW lodgement, EV charger approvals, and trade business growth.",
  "author": {
    "@type": "Organization",
    "name": "TradieAutomate",
    "url": "https://tradieautomate.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Tradie Brain AI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradie Brain AI is a free AI-powered compliance and business advisor built specifically for Australian solar installers, battery storage technicians, and licensed electricians. It answers questions about CER audits, AS/NZS 5033, AS/NZS 5139, CCEW lodgement, STC claims, EV charger approvals, ServiceM8 workflows, and trade business growth — instantly, with no login required."
      }
    },
    {
      "@type": "Question",
      "name": "How do I prepare for a Clean Energy Regulator (CER) audit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To pass a CER audit, you need complete installation records for every solar job including signed customer consent, compliant wiring diagrams, correct STC assignment forms, and evidence of AS/NZS 5033 compliance. Tradie Brain AI can walk you through a pre-audit checklist, explain common CER audit triggers, and advise on documentation gaps. Ask it specific questions about your setup and it will give you step-by-step guidance based on current CER guidelines."
      }
    },
    {
      "@type": "Question",
      "name": "What is the CCEW 7-day rule in NSW?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In NSW, electricians must lodge a Certificate of Compliance Electrical Work (CCEW) within 7 days of completing any electrical installation or alteration work. Failure to lodge on time is a compliance breach under the Home Building Act 1989 and can attract fines. The CCEW must be lodged through the NSW Fair Trading portal. Tradie Brain AI can help you understand what work triggers a CCEW, how to handle partial completions, and how to manage CCEW lodgement at scale using ServiceM8."
      }
    },
    {
      "@type": "Question",
      "name": "What does AS/NZS 5139 cover for battery storage systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AS/NZS 5139:2019 is the Australian and New Zealand standard for the installation of battery energy storage systems (BESS). It covers safety clearances, ventilation requirements, wiring specifications, signage, and documentation for both lithium-ion and lead-acid battery systems. Compliance with AS/NZS 5139 is mandatory for all battery installations in Australia. Tradie Brain AI can explain clearance requirements, answer questions about specific battery brands, and help you document compliance for audit purposes."
      }
    },
    {
      "@type": "Question",
      "name": "Can Tradie Brain AI help with ServiceM8 setup for solar businesses?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tradie Brain AI has deep knowledge of ServiceM8 workflows for solar and electrical businesses, including how to set up job templates for solar installations, configure STC and certificate checklists, manage client paperwork, automate follow-ups, and handle invoicing. It can advise on integrations with Xero and Stripe, and help you build SOPs that ensure every job is CER-audit ready from the moment it's created."
      }
    },
    {
      "@type": "Question",
      "name": "Is Tradie Brain AI free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Tradie Brain AI is completely free to use. No login, no subscription, no credit card required. It's available 24/7 at tradieautomate.com/tools/tradie-brain/ for any Australian solar installer, electrician, or trade contractor who needs fast, accurate compliance and business advice."
      }
    },
    {
      "@type": "Question",
      "name": "What regulations does Tradie Brain AI reference?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradie Brain AI references the following official Australian standards and regulatory frameworks: Clean Energy Regulator (CER) guidelines, AS/NZS 5033 (Installation and Safety Requirements for Photovoltaic Arrays), AS/NZS 5139 (Battery Energy Storage Systems), AS/NZS 3000 (Wiring Rules), Clean Energy Council (CEC) Solar Retailer and Installer Code of Conduct, NSW CCEW requirements under the Home Building Act 1989, Victorian Certificate of Electrical Safety (CES) requirements, and STC (Small-scale Technology Certificate) program rules. Always verify advice against the latest published standards before acting."
      }
    },
    {
      "@type": "Question",
      "name": "What EV charger approval process does Tradie Brain AI cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradie Brain AI covers the full EV charger installation approval process for licensed electricians in Australia, including load calculations, network notification requirements, switchboard upgrade triggers, smart charger configuration, DNSP (Distribution Network Service Provider) requirements by state, and relevant Australian standards. It can also help with quoting, job templates in ServiceM8, and compliance documentation for EV charger installations."
      }
    }
  ]
};
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Tradie Brain AI — Free Solar & Electrical Compliance Advisor",
  "description": "Free AI advisor for Australian solar and electrical contractors. Instant answers on CER audits, AS/NZS 5033 and 5139, ServiceM8, STC claims, CCEW lodgement, EV charger approvals, and trade business growth.",
  "url": "https://tradieautomate.com/tools/tradie-brain/",
  "dateModified": "2026-08-08",
  "publisher": {
    "@type": "Organization",
    "name": "TradieAutomate"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={"Tradie Brain AI — Free Solar & Electrical Compliance Advisor | " + SITE_TITLE}
      description="Ask Tradie Brain AI anything about CER audits, AS/NZS 5033 & 5139, ServiceM8, STC claims, EV chargers and more. Free instant answers for Australian solar and electrical contractors."
    />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <style>
      /* ── Hero (compact) ── */
      .tb-hero {
        text-align: center;
        padding: 28px 24px 16px;
        max-width: 700px;
        margin: 0 auto;
      }
      .tb-hero .badge {
        display: inline-block;
        background: #fff7ed;
        color: #ea580c;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 3px 10px;
        border-radius: 100px;
        margin-bottom: 10px;
      }
      .tb-hero h1 {
        font-size: clamp(1.6rem, 3.5vw, 2.2rem);
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 8px;
        line-height: 1.2;
      }
      .tb-hero .tagline {
        color: #64748b;
        font-size: 0.97rem;
        margin: 0 auto;
        max-width: 480px;
      }

      /* ── Trust bar ── */
      .tb-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        align-items: center;
        margin: 14px auto 20px;
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 600;
      }
      .tb-trust span {
        display: flex;
        align-items: center;
        gap: 5px;
      }
      .tb-trust .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        flex-shrink: 0;
      }

      /* ── Chat UI ── */
      .tb-chat-wrap {
        max-width: 920px;
        margin: 0 auto 40px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 48px rgba(0,0,0,0.12);
        border: 1px solid #e2e8f0;
        background: #09090b;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 140px);
        min-height: 520px;
        max-height: 820px;
      }
      .tb-chat-header {
        background: #0f172a;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #1e293b;
        flex-shrink: 0;
      }
      .tb-chat-header .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        flex-shrink: 0;
      }
      .tb-chat-header span {
        font-size: 0.82rem;
        font-weight: 700;
        color: #f1f5f9;
        letter-spacing: 0.03em;
      }
      .tb-chat-header .sub {
        font-size: 0.72rem;
        color: #64748b;
        font-weight: 400;
        margin-left: auto;
      }
      .tb-chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        scroll-behavior: smooth;
      }
      .tb-chat-messages::-webkit-scrollbar { width: 4px; }
      .tb-chat-messages::-webkit-scrollbar-track { background: transparent; }
      .tb-chat-messages::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

      /* Message bubbles */
      .msg {
        display: flex;
        gap: 10px;
        max-width: 88%;
      }
      .msg.user { align-self: flex-end; flex-direction: row-reverse; }
      .msg.ai   { align-self: flex-start; }
      .msg-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
      }
      .msg.ai .msg-avatar   { background: #1e3a5f; color: #60a5fa; }
      .msg.user .msg-avatar { background: #431407; color: #fb923c; }
      .msg-bubble {
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 0.9rem;
        line-height: 1.65;
      }
      .msg.ai .msg-bubble {
        background: #1e293b;
        color: #e2e8f0;
        border-bottom-left-radius: 4px;
      }
      .msg.user .msg-bubble {
        background: #ea580c;
        color: #fff;
        border-bottom-right-radius: 4px;
      }
      .msg-bubble p { margin: 0 0 8px; }
      .msg-bubble p:last-child { margin-bottom: 0; }
      .msg-bubble ul, .msg-bubble ol { margin: 6px 0; padding-left: 20px; }
      .msg-bubble li { margin-bottom: 4px; }
      .msg-bubble strong { color: #f8fafc; }
      .msg.user .msg-bubble strong { color: #fff; }
      .msg-bubble code {
        background: rgba(255,255,255,0.1);
        padding: 1px 5px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.85em;
      }

      /* Typing indicator */
      .typing-indicator {
        display: flex;
        gap: 4px;
        padding: 12px 14px;
        background: #1e293b;
        border-radius: 12px;
        border-bottom-left-radius: 4px;
        width: fit-content;
      }
      .typing-indicator span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #64748b;
        animation: typing 1.2s ease-in-out infinite;
      }
      .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
      .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
      @keyframes typing {
        0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
        30% { opacity: 1; transform: translateY(-4px); }
      }

      /* Starter prompts */
      .tb-starters {
        padding: 0 20px 20px;
        flex-shrink: 0;
      }
      .tb-starters-label {
        font-size: 0.72rem;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 8px;
      }
      .tb-starters-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 6px;
      }
      @media (max-width: 500px) {
        .tb-starters-grid { grid-template-columns: 1fr; }
      }
      .starter-btn {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 8px 12px;
        text-align: left;
        cursor: pointer;
        font-size: 0.78rem;
        color: #94a3b8;
        font-family: inherit;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
        line-height: 1.4;
      }
      .starter-btn:hover {
        background: #1e3a5f;
        color: #bae6fd;
        border-color: #1e40af;
      }

      /* Input bar */
      .tb-chat-input {
        padding: 12px 16px;
        border-top: 1px solid #1e293b;
        background: #0f172a;
        display: flex;
        gap: 10px;
        align-items: flex-end;
        flex-shrink: 0;
      }
      #chat-input {
        flex: 1;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 10px 14px;
        color: #e2e8f0;
        font-size: 0.9rem;
        font-family: inherit;
        resize: none;
        min-height: 42px;
        max-height: 120px;
        outline: none;
        line-height: 1.5;
        overflow-y: auto;
      }
      #chat-input::placeholder { color: #475569; }
      #chat-input:focus { border-color: #ea580c; }
      #send-btn {
        background: #ea580c;
        border: none;
        border-radius: 10px;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: background 0.15s;
      }
      #send-btn:hover { background: #c2410c; }
      #send-btn:disabled { background: #334155; cursor: not-allowed; }
      #send-btn svg { width: 18px; height: 18px; color: white; }

      /* ── E-E-A-T bar ── */
      .tb-eeat {
        max-width: 920px;
        margin: 0 auto 40px;
        padding: 14px 24px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
        font-size: 0.83rem;
        color: #475569;
      }
      .tb-eeat-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-weight: 600;
      }
      .tb-eeat-item .icon { font-size: 1rem; }
      .tb-eeat .divider { color: #cbd5e1; font-size: 1.2rem; font-weight: 300; }
      @media (max-width: 600px) {
        .tb-eeat { flex-direction: column; gap: 10px; }
        .tb-eeat .divider { display: none; }
      }

      /* ── Capability cards ── */
      .tb-caps {
        max-width: 920px;
        margin: 0 auto 40px;
        padding: 0 24px;
      }
      .tb-caps h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 18px;
        text-align: center;
      }
      .tb-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }
      @media (max-width: 680px) { .tb-cards { grid-template-columns: 1fr; } }
      .tb-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
      }
      .tb-card .card-icon { font-size: 1.6rem; margin-bottom: 8px; display: block; }
      .tb-card h3 { font-size: 0.9rem; font-weight: 700; color: #0f172a; margin: 0 0 8px; }
      .tb-card ul { margin: 0; padding-left: 16px; color: #475569; font-size: 0.82rem; line-height: 1.65; }
      .tb-card li { margin-bottom: 3px; }

      /* ── FAQ accordion ── */
      .tb-faq {
        max-width: 920px;
        margin: 0 auto 64px;
        padding: 0 24px;
      }
      .tb-faq h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 16px;
        text-align: center;
      }
      .faq-item { border-bottom: 1px solid #e2e8f0; }
      .faq-item:last-child { border-bottom: none; }
      .faq-btn {
        width: 100%;
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 4px;
        text-align: left;
        font-size: 0.92rem;
        font-weight: 700;
        color: #0f172a;
        font-family: inherit;
      }
      .faq-btn:hover { color: #ea580c; }
      .faq-chevron {
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        color: #94a3b8;
        transition: transform 0.25s ease;
      }
      .faq-btn[aria-expanded="true"] .faq-chevron { transform: rotate(180deg); color: #ea580c; }
      .faq-body {
        display: none;
        padding: 0 4px 16px;
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.75;
      }
      .faq-body.open { display: block; }

      /* ── Disclaimer toggle ── */
      .tb-disclaimer-wrap {
        max-width: 920px;
        margin: -16px auto 48px;
        padding: 0 24px;
      }
      .tb-disclaimer-toggle {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.78rem;
        color: #94a3b8;
        font-family: inherit;
        padding: 0;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .tb-disclaimer-toggle:hover { color: #64748b; }
      .tb-disclaimer-body {
        display: none;
        margin-top: 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.65;
      }
      .tb-disclaimer-body.open { display: block; }

      @media (max-width: 600px) {
        .tb-chat-wrap { height: 80vh; min-height: 480px; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>

      <!-- Compact hero -->
      <div class="tb-hero">
        <span class="badge">⚡ Free AI Tool</span>
        <h1>Tradie Brain AI</h1>
        <p class="tagline">
          Instant compliance answers for Australian solar installers &amp; electricians —
          trained on CER audit requirements, AS/NZS 5033, AS/NZS 5139, and state
          electrical safety regulations. No login. No fluff.
          <span style="color:#94a3b8;font-size:0.82rem;">Updated 8 August 2026</span>
        </p>
        <div class="tb-trust">
          <span><span class="dot"></span> Free &amp; no login required</span>
          <span>⚡ CER · AS/NZS 5033 · 5139 · 3000</span>
          <span>🔧 ServiceM8 · STC · EV Chargers</span>
          <span>🕐 Available 24/7</span>
        </div>
      </div>

      <!-- Native chat UI -->
      <div class="tb-chat-wrap" id="chat-container">
        <div class="tb-chat-header">
          <span class="status-dot"></span>
          <span>Tradie Brain AI</span>
          <span class="sub">Solar &amp; Electrical Compliance · Australia</span>
        </div>

        <div class="tb-chat-messages" id="chat-messages">
          <!-- Welcome message -->
          <div class="msg ai" id="welcome-msg">
            <div class="msg-avatar">🧠</div>
            <div class="msg-bubble">
              <p><strong>G'day! I'm Tradie Brain.</strong> Ask me anything about solar and electrical compliance, ServiceM8, STC claims, CER audits, EV chargers, or growing your trade business.</p>
              <p>I know AS/NZS 5033, 5139, 3000, CCEW (NSW), CES (VIC), EV charger DNSP requirements, and ServiceM8 inside out. What do you need?</p>
            </div>
          </div>
        </div>

        <!-- Starter prompts (hidden after first message) -->
        <div class="tb-starters" id="starter-prompts">
          <p class="tb-starters-label">Quick starters</p>
          <div class="tb-starters-grid">
            <button class="starter-btn" data-prompt="Give me a pre-CER audit checklist for a solar installer">📋 Pre-CER audit checklist</button>
            <button class="starter-btn" data-prompt="What are the AS/NZS 5139 clearance requirements for a Tesla Powerwall 3 installed in a garage?">🔋 AS/NZS 5139 battery clearances</button>
            <button class="starter-btn" data-prompt="How do I set up a ServiceM8 job template for a solar + battery install that is CER-audit ready?">🔧 ServiceM8 solar job template</button>
            <button class="starter-btn" data-prompt="What DNSP approval do I need to install a 22kW EV charger at a commercial premises in NSW?">⚡ EV charger DNSP approval NSW</button>
          </div>
        </div>

        <!-- Input bar -->
        <div class="tb-chat-input">
          <textarea
            id="chat-input"
            placeholder="Ask Tradie Brain anything about compliance, ServiceM8, or your trade business…"
            rows="1"
            aria-label="Chat input"
          ></textarea>
          <button id="send-btn" aria-label="Send message" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </div>

      <!-- E-E-A-T bar -->
      <div class="tb-eeat">
        <div class="tb-eeat-item">
          <span class="icon">🏗️</span>
          <span>Built for Australian solar &amp; electrical contractors</span>
        </div>
        <span class="divider">|</span>
        <div class="tb-eeat-item">
          <span class="icon">✅</span>
          <span>CEC-accredited installer knowledge base</span>
        </div>
        <span class="divider">|</span>
        <div class="tb-eeat-item">
          <span class="icon">🗓️</span>
          <span>Updated June 2026</span>
        </div>
        <span class="divider">|</span>
        <div class="tb-eeat-item">
          <span class="icon">📖</span>
          <span>References: CER · AS/NZS 5033 · 5139 · 3000 · CEC Code</span>
        </div>
      </div>

      <!-- 3-column capability cards -->
      <section class="tb-caps">
        <h2>What Tradie Brain AI Knows</h2>
        <div class="tb-cards">
          <div class="tb-card">
            <span class="card-icon">📋</span>
            <h3>Compliance &amp; Regulatory</h3>
            <ul>
              <li>CER audit prep &amp; documentation</li>
              <li>AS/NZS 5033 — PV array requirements</li>
              <li>AS/NZS 5139 — Battery BESS installs</li>
              <li>CCEW NSW 7-day lodgement rule</li>
              <li>CES Victoria requirements</li>
              <li>STC claims &amp; common errors</li>
              <li>EV charger DNSP approvals by state</li>
            </ul>
          </div>
          <div class="tb-card">
            <span class="card-icon">🔧</span>
            <h3>ServiceM8 &amp; Operations</h3>
            <ul>
