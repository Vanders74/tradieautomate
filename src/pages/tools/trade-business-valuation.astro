---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BaseHead from '../../components/BaseHead.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import sellability from '../../data/sellability.json';

const title = "Trade Business Valuation Calculator: How Much Is Your Business Worth?";
const description = "Free sellability scorecard for Australian electricians, plumbers and trade businesses — get your SDE/EBITDA multiple, price range, report card and actionable improvements to sell at a top price.";
const tvDataJson = JSON.stringify(sellability).replace(/</g, '\\u003c');
const tvSponsors = JSON.stringify({ systems: [], books: [], coaching: [] }).replace(/</g, '\\u003c');
---

<html lang="en-AU">
  <head>
    <BaseHead title={title} description={description} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://tradieautomate.com/tools/trade-business-valuation/" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Trade Business Valuation Calculator",
      "url": "https://tradieautomate.com/tools/trade-business-valuation/",
      "description": description,
      "applicationCategory": "BusinessApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "AUD" }
    })} />
    <style is:global>
      .tool-hero { background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%); color:#f8fafc; padding:48px 24px; text-align:center; width:100%; box-sizing:border-box; }
      .tool-hero-inner { max-width:800px; margin:0 auto; width:100%; box-sizing:border-box; }
      .tool-hero h1 { font-size:1.8rem; font-weight:800; color:#ffffff; margin-bottom:10px; line-height:1.2; }
      .tool-hero p { color:#cbd5e1; max-width:680px; margin:0 auto; font-size:1rem; }
      .verified-badge { display:inline-block; margin-top:14px; background:#16a34a22; border:1px solid #16a34a55; color:#86efac; padding:4px 12px; border-radius:999px; font-size:.8rem; }
      .tool-body { max-width:760px; margin:0 auto; padding:32px 20px 60px; width:100%; box-sizing:border-box; }
      .value-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-bottom:14px; }
      .vs-item { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:12px 14px; }
      .vs-item strong { display:block; font-size:.88rem; color:#0f172a; margin-bottom:3px; }
      .vs-item span { font-size:.78rem; color:#64748b; line-height:1.4; display:block; }
      .why-line { background:#fff7ed; border-left:3px solid #f97316; border-radius:0 10px 10px 0; padding:12px 16px; font-size:.88rem; color:#7c2d12; line-height:1.6; margin:0 0 18px; }
      .why-line strong { color:#9a3412; }
      .finder-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:24px; box-shadow:0 1px 3px #0000000a; }
      .pf-step { display:none; }
      .pf-step.active { display:block; }
      .opt-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-bottom:4px; }
      .pf-btn { background:#f8fafc; border:1px solid #cbd5e1; border-radius:10px; padding:14px 10px; font-size:.9rem; font-weight:600; color:#0f172a; cursor:pointer; transition:all .15s; text-align:left; }
      .pf-btn:hover { border-color:#f97316; color:#f97316; }
      .pf-btn.selected { border-color:#f97316; color:#f97316; background:#fff7ed; }
      .pf-nav { display:flex; gap:10px; margin-top:18px; }
      .pf-back { background:#f1f5f9; border:1px solid #cbd5e1; color:#334155; padding:10px 18px; border-radius:10px; font-weight:600; cursor:pointer; font-size:.85rem; }
      .pf-back:hover { border-color:#f97316; }
      .result-card { border:1px solid #e2e8f0; border-radius:12px; padding:18px; margin-bottom:14px; }
      .rc-top { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:6px; }
      .rc-top h3 { font-size:1.02rem; color:#0f172a; margin:0; }
      .amt { background:#0f172a; color:#f8fafc; font-weight:700; padding:4px 12px; border-radius:8px; font-size:.9rem; white-space:nowrap; }
      .note { color:#64748b; font-size:.86rem; line-height:1.55; margin:6px 0; }
      .score-bar { height:10px; border-radius:999px; background:#e2e8f0; overflow:hidden; margin:6px 0 14px; }
      .score-bar span { display:block; height:100%; border-radius:999px; }
      .score-rows { margin:10px 0 16px; }
      .score-row { padding:13px 0; border-bottom:1px solid #eef2f7; }
      .score-row:last-child { border-bottom:none; }
      .score-row-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }
      .score-label { font-size:.9rem; font-weight:700; color:#0f172a; }
      .score-val { font-size:.8rem; font-weight:800; color:#0f172a; background:#f1f5f9; border-radius:999px; padding:2px 12px; min-width:44px; text-align:center; }
      .score-track { height:7px; background:#eef2f7; border-radius:999px; overflow:hidden; }
      .score-fill { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#f97316,#fb923c); }
      .score-desc { margin:7px 0 0; font-size:.82rem; color:#64748b; line-height:1.5; }
      .tv-gauge-wrap { position:relative; width:160px; height:160px; margin:0 auto; }
      .tv-gauge-num { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none; }
      .tv-gauge-score { font-size:2.4rem; font-weight:800; color:#0f172a; line-height:1; }
      .tv-gauge-sub { font-size:.72rem; color:#94a3b8; letter-spacing:.1em; margin-top:5px; }
      .tv-band-chip { display:inline-block; margin-top:12px; padding:6px 16px; border-radius:999px; font-weight:800; font-size:.9rem; }
      .tv-price-card { background:linear-gradient(135deg,#0f172a,#1e293b); border-radius:14px; padding:20px 22px; margin:20px 0; text-align:center; }
      .tv-price-label { font-size:.72rem; letter-spacing:.12em; color:#94a3b8; margin:0 0 6px; text-transform:uppercase; }
      .tv-price-range { font-size:2rem; font-weight:800; color:#ffffff; margin:0; line-height:1.15; }
      .tv-price-mult { font-size:.84rem; color:#cbd5e1; margin:8px 0 0; }
      .actions-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:14px 16px; margin-top:12px; }
      .actions-box h4 { margin:0 0 8px; font-size:.92rem; color:#0f172a; }
      .actions-box ul { margin:0; padding-left:18px; color:#475569; font-size:.86rem; line-height:1.6; }
      .cta-row { display:flex; gap:12px; flex-wrap:wrap; margin-top:22px; }
      .cta-primary { background:#f97316; color:#fff; padding:13px 24px; border-radius:10px; font-weight:700; text-decoration:none; font-size:.95rem; display:inline-block; }
      .cta-primary:hover { background:#ea580c; }
      .cta-ghost { border:1px solid #cbd5e1; color:#0f172a; padding:13px 24px; border-radius:10px; font-weight:600; text-decoration:none; font-size:.95rem; display:inline-block; }
      .cta-ghost:hover { border-color:#f97316; }
      .disclaimer { font-size:.75rem; color:#94a3b8; margin-top:24px; line-height:1.5; }
      .sponsor-slot { border:1px dashed #cbd5e1; border-radius:10px; padding:16px; text-align:center; color:#94a3b8; font-size:.85rem; margin-top:24px; }
      .sponsor-panel { border:1px solid #fed7aa; background:linear-gradient(135deg,#fff7ed,#fffbeb); border-radius:12px; padding:18px 20px; margin-top:24px; }
      .sp-panel-head { display:flex; justify-content:space-between; align-items:center; font-size:.8rem; color:#9a3412; margin-bottom:6px; }
      .sp-tag { background:#f97316; color:#fff; font-size:.65rem; font-weight:800; padding:2px 8px; border-radius:6px; letter-spacing:.05em; }
      .sp-panel-title { margin:0 0 4px; font-size:.98rem; font-weight:700; color:#7c2d12; }
      .sp-panel-sub { margin:0; font-size:.85rem; color:#c2410c; }
      .sp-panel-sub a { color:#9a3412; font-weight:700; text-decoration:underline; }
      .related-links { margin-top:28px; border-top:1px solid #e2e8f0; padding-top:20px; }
      .related-links h3 { font-size:1rem; color:#0f172a; margin-bottom:10px; }
      .related-links a { display:block; color:#0284c7; text-decoration:none; font-size:.9rem; padding:4px 0; }
      .related-links a:hover { text-decoration:underline; }
      .sg { margin-top:36px; }
      .sg h2 { font-size:1.3rem; color:#0f172a; margin-bottom:8px; }
      .sg-intro { color:#475569; font-size:.95rem; line-height:1.6; margin-bottom:18px; }
      .sg-block { border-top:1px solid #e2e8f0; padding:14px 0; }
      .sg-block h3 { font-size:1rem; color:#0f172a; margin:0 0 8px; }
      .sg-block ul { list-style:none; margin:0; padding:0; }
      .sg-block li { font-size:.92rem; line-height:1.55; color:#334155; padding:6px 0; border-bottom:1px dashed #f1f5f9; }
      .sg-block li strong { color:#0f172a; display:block; }
      .sg-amt { display:block; color:#c2410c; font-weight:600; margin-top:2px; }
      .sg-faq details { border-bottom:1px solid #e2e8f0; padding:12px 0; }
      .sg-faq summary { font-weight:600; color:#0f172a; font-size:.95rem; cursor:pointer; }
      .sg-faq details p { color:#475569; font-size:.92rem; line-height:1.65; margin:10px 0 0; }
      .lead-form input { padding:10px; border:1px solid #cbd5e1; border-radius:8px; font-size:.9rem; width:100%; box-sizing:border-box; }
      @media (max-width:768px) {
        .tool-hero { padding:36px 18px; }
        .tool-hero h1 { font-size:1.5rem; }
        .tool-hero p { font-size:.95rem; }
        .tool-body { padding:24px 16px 48px; }
        .value-strip { grid-template-columns:1fr; }
        .finder-card { padding:18px; }
        .why-line { padding:10px 14px; font-size:.85rem; }
        .pf-btn { padding:12px 14px; font-size:.85rem; }
        .tv-price-range { font-size:1.6rem; }
      }
      @media (max-width:480px) {
        .opt-grid { grid-template-columns:1fr; }
        .result-card .rc-top { flex-direction:column; gap:4px; align-items:flex-start; }
      }
    </style>
  </head>
  <body>
    <Header />
    <section class="tool-hero">
      <div class="tool-hero-inner">
        <h1>⚡ How Much Is Your Trade Business Worth?</h1>
        <p>12 questions, 90 seconds. Get your indicative sale price range, a sellability report card, and the exact improvements that lift your multiple.</p>
        <span class="verified-badge">✓ Based on current Australian broker multiples (SDE &amp; EBITDA)</span>
      </div>
    </section>

    <main class="tool-body">
      <div class="value-strip">
        <div class="vs-item"><strong>📈 Your price range</strong><span>Broker-style SDE/EBITDA multiple, in plain dollars</span></div>
        <div class="vs-item"><strong>📋 Sellability report card</strong><span>Scores across 8 value drivers — where you're strong, where you leak value</span></div>
        <div class="vs-item"><strong>🎯 Your action plan</strong><span>The 3 highest-leverage fixes, ranked by how much they lift your sale price</span></div>
        <div class="vs-item"><strong>⏱️ 90 seconds · 12 questions · free</strong><span>Estimate updates live as you answer. No sign-up until the end.</span></div>
      </div>
      <p class="why-line"><strong>Why it matters:</strong> Australian trade owners retire in record numbers — most sell for less than they should simply because the business runs on them, not on systems. Every point of multiple you add is real money: a $150K-profit business at 2.0x sells for <strong>$300K</strong>; at 3.0x it's <strong>$450K</strong>. This scorecard shows you which side of that gap you're on — and exactly what closes it.</p>

      <div id="tv-quiz" class="finder-card">
        <h2 style="margin-bottom:14px;font-size:1.15rem;">Sellability Scorecard</h2>
        <div id="tv-live-estimate" style="display:none;background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;padding:12px 16px;margin-bottom:18px;">
          <p style="margin:0;font-size:.85rem;color:#9a3412;">
            <strong id="tv-live-track">So far:</strong> <span id="tv-live-mult">—</span> multiple · sellability <span id="tv-live-score">—</span>/100 ·
            indicative <span id="tv-live-range">—</span>
          </p>
        </div>

        <div class="pf-step active" data-q="0">
          <h3 style="margin-bottom:12px;font-size:1rem;">Business basics</h3>
          <p class="tv-q" data-q="trade" style="font-weight:600;color:#0f172a;margin-bottom:10px;">What trade is the business in?</p>
          <div class="opt-grid" data-q="trade">
            <button class="pf-btn" data-step="0" data-field="trade" data-value="electrician">⚡ Electrician</button>
            <button class="pf-btn" data-step="0" data-field="trade" data-value="plumber">🔧 Plumber</button>
            <button class="pf-btn" data-step="0" data-field="trade" data-value="hvac">❄️ HVAC / Aircon</button>
            <button class="pf-btn" data-step="0" data-field="trade" data-value="solar">☀️ Solar / EV</button>
            <button class="pf-btn" data-step="0" data-field="trade" data-value="builder">🏗️ Builder</button>
            <button class="pf-btn" data-step="0" data-field="trade" data-value="multi">🧰 Mixed / Other</button>
          </div>
          <p class="tv-q" data-q="revenue" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">Rough annual revenue?</p>
          <div class="opt-grid" data-q="revenue">
            <button class="pf-btn" data-step="0" data-field="revenue" data-value="500">Under $500K</button>
            <button class="pf-btn" data-step="0" data-field="revenue" data-value="1m">$500K - $1M</button>
            <button class="pf-btn" data-step="0" data-field="revenue" data-value="2m">$1M - $2M</button>
            <button class="pf-btn" data-step="0" data-field="revenue" data-value="5m">$2M - $5M</button>
            <button class="pf-btn" data-step="0" data-field="revenue" data-value="5p">$5M+</button>
          </div>
          <p class="tv-q" data-q="profit" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">Annual profit before tax, after your own wage?</p>
          <div class="opt-grid" data-q="profit">
            <button class="pf-btn" data-step="0" data-field="profit" data-value="50">$50K - $100K</button>
            <button class="pf-btn" data-step="0" data-field="profit" data-value="100">$100K - $200K</button>
            <button class="pf-btn" data-step="0" data-field="profit" data-value="200">$200K - $350K</button>
            <button class="pf-btn" data-step="0" data-field="profit" data-value="350">$350K - $500K</button>
            <button class="pf-btn" data-step="0" data-field="profit" data-value="500">$500K+</button>
          </div>
        </div>

        <div class="pf-step" data-q="1">
          <h3 style="margin-bottom:12px;font-size:1rem;">Your market position</h3>
          <p class="tv-q" data-q="recurring" style="font-weight:600;color:#0f172a;margin-bottom:10px;">How much revenue is recurring (service plans, maintenance contracts)?</p>
          <div class="opt-grid" data-q="recurring">
            <button class="pf-btn" data-step="1" data-field="recurring" data-value="high">Mostly recurring (60%+)</button>
            <button class="pf-btn" data-step="1" data-field="recurring" data-value="some">Some (20-60%)</button>
            <button class="pf-btn" data-step="1" data-field="recurring" data-value="low">Mostly one-off jobs (&lt;20%)</button>
          </div>
          <p class="tv-q" data-q="growth" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">Revenue trend over the last 2 years?</p>
          <div class="opt-grid" data-q="growth">
            <button class="pf-btn" data-step="1" data-field="growth" data-value="up">Growing</button>
            <button class="pf-btn" data-step="1" data-field="growth" data-value="flat">Flat</button>
            <button class="pf-btn" data-step="1" data-field="growth" data-value="down">Declining</button>
          </div>
          <p class="tv-q" data-q="digital" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">How strong is your digital footprint?</p>
          <div class="opt-grid" data-q="digital">
            <button class="pf-btn" data-step="1" data-field="digital" data-value="strong">Strong — website + reviews</button>
            <button class="pf-btn" data-step="1" data-field="digital" data-value="basic">Basic — one or the other</button>
            <button class="pf-btn" data-step="1" data-field="digital" data-value="none">Minimal — word of mouth</button>
          </div>
        </div>

        <div class="pf-step" data-q="2">
          <h3 style="margin-bottom:12px;font-size:1rem;">How the business runs</h3>
          <p class="tv-q" data-q="independence" style="font-weight:600;color:#0f172a;margin-bottom:10px;">How long could it run without you?</p>
          <div class="opt-grid" data-q="independence">
            <button class="pf-btn" data-step="2" data-field="independence" data-value="weeks">Indefinitely / months</button>
            <button class="pf-btn" data-step="2" data-field="independence" data-value="month">A few weeks</button>
            <button class="pf-btn" data-step="2" data-field="independence" data-value="week">Days to a week</button>
            <button class="pf-btn" data-step="2" data-field="independence" data-value="never">I do most of the work</button>
          </div>
          <p class="tv-q" data-q="concentration" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">Revenue from your top 3 clients?</p>
          <div class="opt-grid" data-q="concentration">
            <button class="pf-btn" data-step="2" data-field="concentration" data-value="low">Under 30%</button>
            <button class="pf-btn" data-step="2" data-field="concentration" data-value="mid">30-60%</button>
            <button class="pf-btn" data-step="2" data-field="concentration" data-value="high">Over 60%</button>
          </div>
          <p class="tv-q" data-q="systems" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">What systems run the business?</p>
          <div class="opt-grid" data-q="systems">
            <button class="pf-btn" data-step="2" data-field="systems" data-value="full">Job software + processes + manager</button>
            <button class="pf-btn" data-step="2" data-field="systems" data-value="some">Job software (ServiceM8 etc.)</button>
            <button class="pf-btn" data-step="2" data-field="systems" data-value="none">Spreadsheets / memory / paper</button>
          </div>
        </div>

        <div class="pf-step" data-q="3">
          <h3 style="margin-bottom:12px;font-size:1rem;">Records &amp; exit plan</h3>
          <p class="tv-q" data-q="books" style="font-weight:600;color:#0f172a;margin-bottom:10px;">How clean are the books?</p>
          <div class="opt-grid" data-q="books">
            <button class="pf-btn" data-step="3" data-field="books" data-value="clean">Great — reconciled monthly</button>
            <button class="pf-btn" data-step="3" data-field="books" data-value="ok">OK — up to date, basic</button>
            <button class="pf-btn" data-step="3" data-field="books" data-value="messy">Behind — a struggle</button>
          </div>
          <p class="tv-q" data-q="compliance" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">Licences, WHS and compliance?</p>
          <div class="opt-grid" data-q="compliance">
            <button class="pf-btn" data-step="3" data-field="compliance" data-value="clean">All current, WHS documented</button>
            <button class="pf-btn" data-step="3" data-field="compliance" data-value="ok">Licences current, WHS informal</button>
            <button class="pf-btn" data-step="3" data-field="compliance" data-value="gaps">Gaps or expiry issues</button>
          </div>
          <p class="tv-q" data-q="horizon" style="font-weight:600;color:#0f172a;margin:18px 0 10px;">When do you want to exit or sell?</p>
          <div class="opt-grid" data-q="horizon">
            <button class="pf-btn" data-step="3" data-field="horizon" data-value="soon">Within 1-2 years</button>
            <button class="pf-btn" data-step="3" data-field="horizon" data-value="medium">3-5 years</button>
            <button class="pf-btn" data-step="3" data-field="horizon" data-value="exploring">Just exploring</button>
            <button class="pf-btn" data-step="3" data-field="horizon" data-value="later">5+ years / not sure</button>
          </div>
        </div>

        <div class="pf-nav">
          <button class="pf-back" id="tv-back">← Back</button>
          <button class="pf-back" id="tv-reset">↺ Start over</button>
        </div>
      </div>

      <div id="tv-results" style="display:none;">
        <div class="finder-card">
          <h2 style="font-size:1.3rem;color:#0f172a;margin-bottom:4px;">Your Sellability Report</h2>
          <p class="sub" id="tv-summary" style="color:#64748b;font-size:.9rem;margin-bottom:14px;"></p>

          <div style="text-align:center;padding:10px 0 2px;">
            <div class="tv-gauge-wrap">
              <svg viewBox="0 0 120 120" width="160" height="160" aria-hidden="true">
                <circle cx="60" cy="60" r="52" fill="none" stroke="#eef2f7" stroke-width="11" />
                <circle id="tv-score-ring" cx="60" cy="60" r="52" fill="none" stroke="#f97316" stroke-width="11" stroke-linecap="round"
                  stroke-dasharray="326.7" stroke-dashoffset="326.7" transform="rotate(-90 60 60)" style="transition:stroke-dashoffset .8s ease, stroke .8s ease;" />
              </svg>
              <div class="tv-gauge-num">
                <span class="tv-gauge-score" id="tv-score">--</span>
                <span class="tv-gauge-sub">SELLABILITY SCORE</span>
              </div>
            </div>
            <div><span class="tv-band-chip" id="tv-band" style="background:#f1f5f9;color:#0f172a;"></span></div>
            <p id="tv-blurb" style="color:#64748b;font-size:.86rem;max-width:540px;margin:12px auto 0;line-height:1.55;"></p>
          </div>

          <div class="tv-price-card">
            <p class="tv-price-label">Indicative sale range</p>
            <p class="tv-price-range" id="tv-price-range">—</p>
            <p class="tv-price-mult" id="tv-multiple"></p>
          </div>

          <div class="score-rows" id="tv-scores"></div>
          <p style="font-size:.74rem;color:#94a3b8;margin:-6px 0 14px;">Each score is out of 100 and compared against what Australian buyers actually pay for.</p>

          <div class="actions-box" id="tv-actions">
            <h4>🎯 Priority actions to lift your multiple</h4>
            <ul id="tv-action-list"></ul>
          </div>

          <div style="margin-top:18px;">
            <button class="cta-primary" id="tv-cta" style="border:none;cursor:pointer;width:100%;text-align:center;">📥 Email me my report + action plan (free)</button>
            <p style="margin:8px 0 0;font-size:.78rem;color:#94a3b8;text-align:center;">We'll send your personalised summary — score, range, report card and your ranked action plan — to your inbox. No spam, unsubscribe anytime.</p>
