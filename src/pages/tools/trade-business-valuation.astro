    <Footer />
    <script is:inline set:html={`window.__TV_DATA = ${tvDataJson};\nwindow.__TV_SPONSORS = ${tvSponsors};`}></script>
    <script is:inline>
      (function(){
        var QUIZ = document.getElementById('tv-quiz');
        var RESULTS = document.getElementById('tv-results');
        var DATA = window.__TV_DATA;
        if(!QUIZ || !DATA) return;
        var steps = Array.prototype.slice.call(QUIZ.querySelectorAll('.pf-step'));
        var answers = {};
        /* Deep-link support: the emailed "View my results" link carries your
           answers as a ?r= token — decode it so the report renders directly. */
        try {
          var rp = new URLSearchParams(window.location.search).get('r');
          if (rp) {
            rp = rp.replace(/-/g, '+').replace(/_/g, '/');
            rp += '='.repeat((4 - (rp.length % 4)) % 4);
            var tok = JSON.parse(atob(rp));
            if (tok && tok.a && typeof tok.a === 'object') answers = tok.a;
          }
        } catch (e) { /* invalid token — fall back to the normal quiz */ }
        var current = 0;
        function showStep(n){
          current = n;
          steps.forEach(function(s){ s.classList.toggle('active', parseInt(s.getAttribute('data-q'),10) === n); });
        }
        function val(id){ var v = DATA.questions.filter(function(q){return q.id===id}); return v.length ? v[0] : null; }
        function opt(id, value){ var q = val(id); if(!q) return null; for(var i=0;i<q.options.length;i++){ if(q.options[i].value===value) return q.options[i]; } return null; }
        function scoreQ(id){
          var q = val(id); var o = opt(id, answers[id]);
          if(!q || !o || q.options.length<2) return null;
          for(var i=0;i<q.options.length;i++){ if(q.options[i]===o) return (q.options.length-1-i)/(q.options.length-1); }
          return null;
        }
        function compute(){
          var tt = DATA.trade_types[answers.trade] || DATA.trade_types.multi;
          var t = { base_sde: tt.base_sde, base_ebitda: tt.base_ebitda };
          var adjKeys = ['recurring','growth','digital','independence','concentration','systems','books','compliance','horizon'];
          var adj = 0;
          for(var i=0;i<adjKeys.length;i++){ var o=opt(adjKeys[i], answers[adjKeys[i]]); if(o && typeof o.adj==='number') adj += o.adj; }
          if(adj > DATA.adjustment_cap) adj = DATA.adjustment_cap;
          if(adj < -DATA.adjustment_cap) adj = -DATA.adjustment_cap;
          var profitMid = 150; var pb = DATA.profit_bands.filter(function(b){return b.id===answers.profit}); if(pb.length) profitMid = pb[0].mid;
          var revMid = 750; var rb = DATA.revenue_bands.filter(function(b){return b.id===answers.revenue}); if(rb.length) revMid = rb[0].mid;
          var useEbitda = revMid >= 2000;
          var base = useEbitda ? t.base_ebitda : t.base_sde;
          var mult = base + adj;
          var low = Math.max(1.0, mult - 0.5); var high = mult + 0.5;
          var w = DATA.score_weights;
          var weights = { recurring: w.recurring, growth: w.financial, digital: w.digital, independence: w.independence, concentration: w.customers, systems: w.systems, books: w.books, compliance: w.compliance };
          var totalScore = 0; var totalWeight = 0;
          for(var k in weights){ var s = scoreQ(k); if(s!==null){ totalScore += s*weights[k]; totalWeight += weights[k]; } }
          var score = totalWeight ? Math.round(100*totalScore/totalWeight) : 50;
          var band = DATA.bands[0];
          for(var b=0;b<DATA.bands.length;b++){ if(score >= DATA.bands[b].min){ band = DATA.bands[b]; break; } }
          return { mult: mult, low: low, high: high, profitMid: profitMid, useEbitda: useEbitda, score: score, band: band, adj: adj };
        }
        function money(n){ if(n>=1000000){ return '$' + (n/1000000).toFixed(n>=10000000?1:2) + 'M'; } if(n>=1000){ return '$' + (n/1000).toFixed(n>=100000?0:1) + 'K'; } return '$' + Math.round(n).toLocaleString(); }
        function actionFor(k, score){
          /* Whole-range planner: below 0.55 = fix, 0.55-0.8 = improve, above = protect.
             Every area returns a tiered action so no score range is left empty. */
          if(score == null) return null;
          var tier = score < 0.55 ? 'low' : (score < 0.8 ? 'mid' : 'high');
          return DATA.action_map[tier + '_' + k] || null;
        }
        function updateLive(){
          var box = document.getElementById('tv-live-estimate');
          var n = Object.keys(answers).length;
          if(!box || n < 2){ return; }
          var c = compute();
          box.style.display = 'block';
          document.getElementById('tv-live-mult').textContent = c.mult.toFixed(1) + 'x';
          document.getElementById('tv-live-score').textContent = c.score;
          document.getElementById('tv-live-range').textContent = money(c.profitMid*1000*c.low) + ' - ' + money(c.profitMid*1000*c.high);
          if(n < 4){ document.getElementById('tv-live-track').textContent = 'So far (rough);'; }
          else { document.getElementById('tv-live-track').textContent = 'Live estimate:'; }
        }
        var labelMap = { recurring:'Recurring revenue', growth:'Growth momentum', digital:'Digital footprint', independence:'Owner independence', concentration:'Client concentration', systems:'Systems & processes', books:'Books & records', compliance:'Compliance & WHS' };
        var descMap = {
          recurring: 'Regular income from service plans and maintenance contracts. Buyers pay more for money they can count on.',
          growth: 'Your revenue trend over the past 2 years — steady growth signals a business that keeps winning.',
          digital: 'Your website and online reviews. Buyers (and their lenders) check this first — it sets the first impression of value.',
          independence: 'Can the business run without you? The more it runs on its own, the more a buyer can own it — and the more they pay.',
          concentration: 'How much revenue comes from your top few clients. Heavy reliance on one or two customers is a big risk for buyers.',
          systems: 'Job software, documented processes and a manager running day-to-day. This is the core of a sellable business.',
          books: 'Clean, reconciled records. Buyers discount or walk away from messy books — it is the deal killer we hear most.',
          compliance: 'Licences, WHS and paperwork current and documented. Gaps here block sales entirely or force heavy discounts.'
        };
        var sponsorMap = { systems:'systems', books:'books', digital:'systems', recurring:'coaching', growth:'coaching', independence:'coaching', concentration:'coaching', compliance:'systems', horizon:'coaching' };
        var sponsorLabel = { systems:'Software & systems partner', books:'Accounting & bookkeeping', coaching:'Business coaching & advisory' };
        function renderSponsor(scores){
          var slot = document.getElementById('tv-sponsor-slot');
          if(!slot || !window.__TV_SPONSORS) return;
          var key = null; var worst = 1.1;
          for(var k in scores){ if(scores[k]!==null && scores[k]<worst){ worst = scores[k]; key = k; } }
          var list = key ? (window.__TV_SPONSORS[sponsorMap[key]] || []) : [];
          var sp = list.length ? list[0] : null;
          var catLabel = sponsorLabel[key ? sponsorMap[key] : 'coaching'] || 'Systems & software partner';
          var catEl = document.getElementById('tv-sponsor-category');
          if(catEl){ catEl.textContent = catLabel.toLowerCase(); }
          var title = document.getElementById('tv-sponsor-title');
          var sub = document.getElementById('tv-sponsor-sub');
          if(sp && sp.name){
            if(title){ title.textContent = sp.name + ' — ' + (sp.offer || 'partner'); }
            if(sub){ sub.innerHTML = sp.url ? 'This sponsor helps trade owners like you. <a href="' + sp.url + '" rel="sponsored nofollow">Learn more →</a>' : 'This sponsor helps trade owners like you.'; }
          } else {
            if(title){ title.textContent = 'Help trade owners prepare &amp; sell their business'; title.innerHTML = 'Help trade owners prepare &amp; sell their business'; }
            if(sub){ sub.innerHTML = 'Looking for a <span id="tv-sponsor-category">' + catLabel.toLowerCase() + '</span> partner matched to your results? This placement is reserved for a sponsor. <a href="mailto:info@tradieautomate.com">Partner with us →</a>'; }
          }
        }
        var lastResult = null;
        var lastActions = [];
        var MAINTAIN_PLAN = [
          'Maintain your service plans and systems — recurring income keeps your multiple at its peak.',
          'Keep books reconciled monthly and document processes — buyers pay more for proven, steady operations.',
          'Retain your key staff and document their roles — a business that runs without you is worth more at sale.'
        ];
        function render(){
          var c = compute();
          lastResult = c;
          var ring = document.getElementById('tv-score-ring');
          var scoreEl = document.getElementById('tv-score');
          if(ring){ ring.style.strokeDashoffset = (326.7 * (1 - c.score/100)).toFixed(1); ring.style.stroke = c.band.color; }
          if(scoreEl){ scoreEl.textContent = c.score; }
          var bandEl = document.getElementById('tv-band');
          if(bandEl){
            bandEl.textContent = c.band.label;
            bandEl.style.background = c.band.color + '22';
            bandEl.style.color = c.band.color;
            bandEl.style.border = '1px solid ' + c.band.color + '66';
          }
          document.getElementById('tv-blurb').textContent = c.band.blurb;
          var unit = c.useEbitda ? 'EBITDA' : 'SDE';
          document.getElementById('tv-multiple').textContent = 'Adjusted ' + unit + ' multiple: ' + c.mult.toFixed(1) + 'x';
          document.getElementById('tv-price-range').textContent = money(c.profitMid*1000*c.low) + ' - ' + money(c.profitMid*1000*c.high);
          var rows = '';
          var actionKeys = ['recurring','independence','systems','books','digital','compliance','growth','concentration'];
          var scores = {};
          for(var i=0;i<actionKeys.length;i++){ var s = scoreQ(actionKeys[i]); scores[actionKeys[i]]=s; if(s!==null){
            var pct = Math.round(s*100);
            rows += '<div class="score-row"><div class="score-row-head"><span class="score-label">' + labelMap[actionKeys[i]] + '</span><span class="score-val">' + pct + '</span></div>'
              + '<div class="score-track"><span class="score-fill" style="width:' + pct + '%"></span></div>'
              + '<p class="score-desc">' + (descMap[actionKeys[i]] || '') + '</p></div>';
          } }
          document.getElementById('tv-scores').innerHTML = rows;
          var actions = [];
          /* Collect the 3 WEAKEST areas' actions (all tiers now produce one). */
          var weakest = actionKeys.slice().sort(function(a,b){ return (scores[a]==null?1.1:scores[a]) - (scores[b]==null?1.1:scores[b]); });
          for(var w=0; w<weakest.length && actions.length<3; w++){ var wa = actionFor(weakest[w], scores[weakest[w]]); if(wa && actions.indexOf(wa)<0) actions.push(wa); }
          /* Absolute fallback if nothing qualifies (shouldn't happen — tiered planner covers all). */
          if(!actions.length){ actions = MAINTAIN_PLAN.slice(); }
          lastActions = actions.slice(0,3);
          document.getElementById('tv-action-list').innerHTML = actions.length ? actions.map(function(a){return '<li>'+a+'</li>';}).join('') : '<li>Strong setup — focus on maintaining your systems and documenting processes for the buyer.</li>';
          document.getElementById('tv-summary').textContent = 'Based on AU broker multiples for ' + (opt('trade',answers.trade) ? opt('trade',answers.trade).label.replace(/^[^:]+:\s*/,'') : 'trade businesses') + ' (indicative only).';
          renderSponsor(scores);
          QUIZ.style.display = 'none';
          RESULTS.style.display = 'block';
          if(window.gtag){ gtag('event','sellability_report',{score:c.score, trade:answers.trade||'none', horizon:answers.horizon||'none'}); }
        }
        function resetQuiz(){
          answers = {}; current = 0;
          QUIZ.style.display = 'block'; RESULTS.style.display = 'none';
          steps.forEach(function(s){ s.classList.remove('active'); });
          showStep(0);
          var sel = QUIZ.querySelectorAll('.pf-btn.selected');
          for(var i=0;i<sel.length;i++){ sel[i].classList.remove('selected'); }
        }
        QUIZ.addEventListener('click', function(e){
          var b = e.target.closest ? e.target.closest('.pf-btn') : null;
          if(!b) return;
          var st = parseInt(b.getAttribute('data-step'), 10);
          var field = b.getAttribute('data-field');
          var v = b.getAttribute('data-value');
          var siblings = b.parentElement.querySelectorAll('.pf-btn');
          for(var i=0;i<siblings.length;i++){ siblings[i].classList.remove('selected'); }
          b.classList.add('selected');
          answers[field] = v;
          updateLive();
          var stepDone = true;
          var qs = QUIZ.querySelectorAll('.tv-q[data-q="' + field + '"]');
          if(st === 0){
            if(!answers.trade || !answers.revenue || !answers.profit) stepDone = false;
          } else if(st === 1){
            if(!answers.recurring || !answers.growth || !answers.digital) stepDone = false;
          } else if(st === 2){
            if(!answers.independence || !answers.concentration || !answers.systems) stepDone = false;
          } else if(st === 3){
            if(!answers.books || !answers.compliance || !answers.horizon) stepDone = false;
          }
          if(stepDone){
            if(st < 3){ showStep(st+1); }
            else { render(); }
          }
        });
        var backBtn = document.getElementById('tv-back');
        if(backBtn){ backBtn.addEventListener('click', function(){ if(current>0) showStep(current-1); }); }
        var resetBtn = document.getElementById('tv-reset');
        if(resetBtn){ resetBtn.addEventListener('click', resetQuiz); }
        var cta = document.getElementById('tv-cta');
        if(cta){ cta.addEventListener('click', function(){ var f=document.getElementById('tv-lead-form'); if(f) f.style.display='block'; }); }
        var leadForm = document.getElementById('tv-lead-form-el');
        if(leadForm){ leadForm.addEventListener('submit', function(e){
          e.preventDefault();
          var email = document.getElementById('tv-lead-email').value.trim();
          var err = document.getElementById('tv-lead-err');
          var msg = document.getElementById('tv-lead-msg');
          if(!email || email.indexOf('@')<0){ if(err){ err.textContent='Enter a valid email.'; err.style.display='block'; } return; }
          if(err) err.style.display='none';
          function done(ok){
            if(ok){ if(msg) msg.style.display='block'; if(window.gtag){ gtag('event','sellability_report_download',{email_provided:1}); } }
            else { if(err){ err.textContent='We couldn\u2019t send your report just now — the email service may be lagging. Try again in a minute, or email us at info@tradieautomate.com and we\u2019ll send it right over.'; err.style.display='block'; } }
          }
          fetch('/.netlify/functions/trade-exit-lead', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({
              email: email,
              score: (lastResult||compute()).score,
              trade: answers.trade||'',
              horizon: answers.horizon||'',
              low: Math.round((lastResult||compute()).profitMid*1000*(lastResult||compute()).low),
              high: Math.round((lastResult||compute()).profitMid*1000*(lastResult||compute()).high),
              band: (lastResult||compute()).band.label,
              actions: lastActions.join('|'),
              token: (function(){ try { return btoa(JSON.stringify({a: answers})).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,''); } catch(e){ return ''; } })()
            })
          }).then(function(r){return r.json();}).then(function(d){
            /* Only claim delivery when Brevo actually accepted the email. */
            done(d && d.success && d.emailSent === true);
          }).catch(function(){ done(false); });
        }); }

        /* Deep-link: if answers arrived via ?r= token, render the report immediately. */
        if (Object.keys(answers).length) {
          try { render(); } catch(e) { /* fall back to quiz on any error */ }
        }
      })();
    </script>
