---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { SITE_TITLE } from '../../consts';
import rebatesJson from '../../data/rebates.json';

const programs = rebatesJson.programs;
const meta = rebatesJson.meta;

// Static, server-rendered rebate summary. The finder itself is JS-rendered, which
// left the page with almost no crawlable text — Google would not index it
// ("URL is unknown to Google" / "Discovered - not indexed"). This block gives the
// page real, unique content tied to the same data the tool uses.
const STATE_LABELS = {
  VIC: 'Victoria', NSW: 'New South Wales', QLD: 'Queensland', SA: 'South Australia',
  WA: 'Western Australia', TAS: 'Tasmania', ACT: 'ACT', NT: 'Northern Territory',
  ALL: 'All states + federal programs',
};
const STATE_ORDER = ['VIC', 'NSW', 'QLD', 'SA', 'WA', 'ACT', 'TAS', 'NT', 'ALL'];
const STATE_GROUPS = STATE_ORDER.map((st) => [
  st,
  STATE_LABELS[st],
  Object.values(programs).filter((p) => p.state === st),
]).filter((g) => g[2].length > 0);
// Serialize safely for inline JS injection (escape < to avoid HTML parsing issues)
const rfDataJson = JSON.stringify(rebatesJson).replace(/</g, '\\u003c');

const title = "Solar Rebate Calculator Australia 2026 | Rebates by State";
const description = "Free solar rebate calculator for Australia 2026 — see exact solar, battery and heat pump rebate amounts, eligibility and expiry dates by state.";
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Solar Rebate Calculator Australia 2026",
  "description": description,
  "url": "https://tradieautomate.com/tools/rebate-finder/",
  "dateModified": meta.last_verified,
  "publisher": { "@type": "Organization", "name": "TradieAutomate" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the best heat pump hot water rebate in Australia in 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "Victoria offers the largest state rebate: up to $1,000 via Solar Homes (up to $1,400 for locally-made systems) stacking with VEU discounts of up to $560. NSW offers up to $640 via the Energy Savings Scheme. Queensland has no state rebate — households get the federal STC discount of $500-$800 off the quote." }
    },
    {
      "@type": "Question",
      "name": "Are there solar and battery rebates in my state in 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "Victoria still offers the Solar Homes panel rebate (up to $1,400), but its battery interest-free loan is closed to new applications. NSW battery buyers use the Home Energy Saver program (up to $4,000 discount or $15,000 zero-interest loan). Queensland's Battery Booster closed in May 2024 — the federal Cheaper Home Batteries Program (~30% off) is the main battery incentive nationally." }
    },
    {
      "@type": "Question",
      "name": "Is the TradieAutomate rebate finder free?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. The rebate finder is completely free — no email or sign-up. Rebate data is verified against official sources (Solar Victoria, NSW Climate and Energy Action, Service NSW, Clean Energy Regulator) on a weekly cycle." }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <style>
      .tool-hero { text-align:center; padding:48px 24px 24px; background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%); color:#e2e8f0; }
      .tool-hero h1 { font-size:clamp(1.8rem,4vw,2.6rem); font-weight:800; margin-bottom:12px; color:#fff; }
      .tool-hero p { color:#94a3b8; max-width:560px; margin:0 auto; font-size:1rem; line-height:1.6; }
      .verified-badge { display:inline-block; margin-top:14px; background:#0f766e; color:#fff; font-size:.8rem; padding:4px 12px; border-radius:20px; }
      .tool-body { max-width:760px; margin:0 auto; padding:28px 20px 60px; }
      .sg { margin-top:36px; }
      .sg h2 { font-size:1.3rem; color:#0f172a; margin-bottom:8px; }
      .sg-intro { color:#475569; font-size:.95rem; line-height:1.6; margin-bottom:18px; }
      .sg-block { border-top:1px solid #e2e8f0; padding:14px 0; }
      .sg-block h3 { font-size:1rem; color:#0f172a; margin:0 0 8px; }
      .sg-block ul { list-style:none; margin:0; padding:0; }
      .sg-block li { font-size:.92rem; line-height:1.55; color:#334155; padding:5px 0; border-bottom:1px dashed #f1f5f9; }
      .sg-block li strong { color:#0f172a; }
      .sg-amt { display:block; color:#c2410c; font-weight:600; margin-top:2px; }
      .sg-closed { display:inline-block; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; background:#f1f5f9; color:#64748b; padding:2px 8px; border-radius:20px; margin-top:4px; }
      .sg-faq details { border-bottom:1px solid #e2e8f0; padding:12px 0; }
      .sg-faq summary { font-weight:600; color:#0f172a; font-size:.95rem; cursor:pointer; }
      .sg-faq details p { color:#475569; font-size:.92rem; line-height:1.65; margin:10px 0 0; }
      .finder-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:24px; margin-bottom:20px; box-shadow:0 2px 12px rgba(0,0,0,.04); }
      .finder-card h2 { font-size:1.25rem; color:#0f172a; margin-bottom:4px; }
      .finder-card .sub { color:#64748b; font-size:.9rem; margin-bottom:18px; }
      .opt-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; }
      .pf-btn { background:#f8fafc; border:1px solid #cbd5e1; border-radius:10px; padding:14px 16px; font-size:.95rem; font-weight:600; color:#0f172a; cursor:pointer; text-align:left; transition:all .15s; }
      .pf-btn:hover { border-color:#f97316; }
      .pf-btn.selected { border-color:#f97316; background:#fff7ed; color:#c2410c; }
      .pf-step { display:none; }
      .pf-step.active { display:block; }
      .pf-nav { margin-top:18px; display:flex; gap:10px; }
      .pf-back { background:#f1f5f9; border:1px solid #e2e8f0; color:#475569; padding:10px 20px; border-radius:8px; cursor:pointer; font-size:.9rem; }
      .pf-back:hover { background:#e2e8f0; }
      .results-loading { text-align:center; padding:32px; color:#64748b; }
      .result-card { border:1px solid #e2e8f0; border-left:4px solid #f97316; border-radius:12px; padding:20px; margin-bottom:16px; background:#fff; }
      .result-card.closed { opacity:.6; border-left-color:#94a3b8; }
      .result-card .rc-top { display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
      .result-card h3 { font-size:1.05rem; color:#0f172a; margin:0 0 4px; }
      .result-card .amt { font-size:1.3rem; font-weight:700; color:#c2410c; white-space:nowrap; }
      .result-card .status-tag { font-size:.75rem; font-weight:700; padding:3px 10px; border-radius:20px; }
      .status-open { background:#dcfce7; color:#166534; }
      .status-closed { background:#f1f5f9; color:#64748b; }
      .result-card .note { font-size:.88rem; color:#475569; margin-top:10px; line-height:1.55; }
      .elig-list { margin:10px 0 0; padding-left:0; list-style:none; font-size:.85rem; color:#475569; }
      .elig-list li { padding:3px 0 3px 20px; position:relative; }
      .elig-list li::before { content:'✓'; position:absolute; left:0; color:#16a34a; font-weight:700; }
      .elig-list li.miss::before { content:'✗'; color:#dc2626; }
      .src-line { font-size:.8rem; color:#94a3b8; margin-top:12px; }
      .src-line a { color:#0284c7; text-decoration:none; }
      .src-line a:hover { text-decoration:underline; }
      .claim-box { margin-top:14px; background:#fff7ed; border-radius:8px; padding:12px 14px; font-size:.88rem; color:#7c2d12; }
      .cta-row { display:flex; gap:12px; flex-wrap:wrap; margin-top:22px; }
      .cta-primary { background:#f97316; color:#fff; padding:13px 24px; border-radius:10px; font-weight:700; text-decoration:none; font-size:.95rem; display:inline-block; }
      .cta-primary:hover { background:#ea580c; }
      .cta-ghost { border:1px solid #cbd5e1; color:#0f172a; padding:13px 24px; border-radius:10px; font-weight:600; text-decoration:none; font-size:.95rem; display:inline-block; }
      .cta-ghost:hover { border-color:#f97316; }
      .disclaimer { font-size:.75rem; color:#94a3b8; margin-top:24px; line-height:1.5; }
      .sponsor-slot { border:1px dashed #cbd5e1; border-radius:10px; padding:16px; text-align:center; color:#94a3b8; font-size:.85rem; margin-top:24px; }
      .related-links { margin-top:28px; border-top:1px solid #e2e8f0; padding-top:20px; }
      .related-links h3 { font-size:1rem; color:#0f172a; margin-bottom:10px; }
      .related-links a { display:block; color:#0284c7; text-decoration:none; font-size:.9rem; padding:4px 0; }
      .related-links a:hover { text-decoration:underline; }
      @media (max-width:480px) { .opt-grid { grid-template-columns:1fr; } .result-card .rc-top { flex-direction:column; gap:4px; } }
    </style>
  </head>
  <body>
    <Header />
    <section class="tool-hero">
      <h1>🇦🇺 Solar Rebate Calculator Australia 2026</h1>
      <p>Heat pump, solar &amp; battery rebates in your state — exact amounts, eligibility and expiry dates. Verified against official sources weekly.</p>
      <span class="verified-badge">✓ Last verified {meta.last_verified}</span>
    </section>

    <main class="tool-body">
      <div id="rf-quiz" class="finder-card">
        <h2>Find your rebates</h2>
        <p class="sub">Answer 3 quick questions — ranked results in seconds.</p>

        <div class="pf-step active" data-q="0">
          <h3 style="margin-bottom:14px;font-size:1.05rem;">1. Which state are you in?</h3>
          <div class="opt-grid">
            <button class="pf-btn" data-step="0" data-field="state" data-value="VIC">VIC</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="NSW">NSW</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="QLD">QLD</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="SA">SA</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="WA">WA</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="TAS">TAS</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="ACT">ACT</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="NT">NT</button>
            <button class="pf-btn" data-step="0" data-field="state" data-value="ALL">🌏 All states + federal</button>
          </div>
        </div>

        <div class="pf-step" data-q="1">
          <h3 style="margin-bottom:14px;font-size:1.05rem;">2. What upgrade are you planning?</h3>
          <div class="opt-grid">
            <button class="pf-btn" data-step="1" data-field="category" data-value="heat_pump">♨️ Heat pump hot water</button>
            <button class="pf-btn" data-step="1" data-field="category" data-value="solar_hot_water">☀️ Solar hot water</button>
            <button class="pf-btn" data-step="1" data-field="category" data-value="solar">⚡ Solar panels</button>
            <button class="pf-btn" data-step="1" data-field="category" data-value="battery">🔋 Home battery</button>
          </div>
        </div>

        <div class="pf-step" data-q="2">
          <h3 style="margin-bottom:14px;font-size:1.05rem;">3. Who owns the property?</h3>
          <div class="opt-grid">
            <button class="pf-btn" data-step="2" data-field="owner" data-value="owner">🏠 Owner-occupier</button>
            <button class="pf-btn" data-step="2" data-field="owner" data-value="business">🏢 Business / tradie</button>
            <button class="pf-btn" data-step="2" data-field="owner" data-value="other">🏘️ Rental / other</button>
          </div>
        </div>

        <div class="pf-nav">
          <button class="pf-back" id="rf-back">← Back</button>
          <button class="pf-back" id="rf-reset">↺ Start over</button>
        </div>
      </div>

      <div id="rf-results" style="display:none;">
        <h2 style="font-size:1.3rem;color:#0f172a;margin-bottom:6px;">Your rebates</h2>
        <p class="sub" id="rf-summary" style="color:#64748b;font-size:.9rem;margin-bottom:18px;"></p>
        <div style="margin-bottom:14px;"><button class="pf-back" id="rf-results-reset" style="padding:8px 16px;">↺ Start over — change state or upgrade</button></div>
        <div id="rf-result-list"></div>

        <div class="cta-row">
          <a class="cta-primary" id="rf-tradie-cta" href="/services/">Need a tradie? Get matched with an installer →</a>
          <a class="cta-ghost" href="/blog/heat-pump-hot-water-installation-electricians-australia/">Heat pump installation guide →</a>
        </div>

        <div id="rf-lead-form" class="lead-form" style="display:none;margin-top:18px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:18px;">
          <h3 style="font-size:1rem;color:#0f172a;margin-bottom:6px;">Get matched with a <span id="rf-lead-state-label"></span> installer</h3>
          <p style="font-size:.85rem;color:#64748b;margin-bottom:12px;">Free, no obligation. We'll send your details to one vetted installer in your area.</p>
          <form id="rf-lead-form-el">
            <input type="hidden" id="rf-lead-state" />
            <input type="hidden" id="rf-lead-upgrade" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
              <input type="text" id="rf-lead-name" placeholder="Your name" required style="padding:10px;border:1px solid #cbd5e1;border-radius:8px;font-size:.9rem;width:100%;box-sizing:border-box;" />
              <input type="email" id="rf-lead-email" placeholder="Email" required style="padding:10px;border:1px solid #cbd5e1;border-radius:8px;font-size:.9rem;width:100%;box-sizing:border-box;" />
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
              <input type="text" id="rf-lead-postcode" placeholder="Postcode" pattern="[0-9]{4}" style="padding:10px;border:1px solid #cbd5e1;border-radius:8px;font-size:.9rem;width:100%;box-sizing:border-box;" />
              <button type="submit" class="cta-primary" style="border:none;cursor:pointer;">Get matched — it's free →</button>
            </div>
            <p id="rf-lead-msg" style="display:none;font-size:.9rem;color:#16a34a;margin-top:8px;">✓ Request sent — we'll be in touch within 24 hours.</p>
            <p style="display:none;font-size:.85rem;color:#dc2626;" id="rf-lead-err"></p>
          </form>
        </div>

        <div class="sponsor-slot" id="rf-sponsor-slot">📢 Sponsor slot — your rebate-eligible product or installer service could appear here (contact info@tradieautomate.com)</div>

        <div class="related-links">
          <h3>Related guides</h3>
          <a href="/blog/victorian-energy-upgrades-veu-electricians-guide-2026/">VEU Guide for Electricians 2026</a>
          <a href="/blog/heat-pump-hot-water-installation-electricians-australia/">Heat Pump Hot Water Installation Guide</a>
          <a href="/blog/solar-playbook-2026-battery-upgrade/">Solar + Battery Upgrade Playbook 2026</a>
          <a href="/blog/how-to-price-solar-installations-australia-2026/">Solar Install Pricing 2026 — what a job actually costs to deliver</a>
          <a href="/blog/solar-battery-system-cost-australia-2026/">Battery System Costs 2026 — what the rebate does not cover</a>
          <a href="/blog/staying-compliant-2026-solar-electrical-safety/">Installer Compliance 2026 — CER, SWMS &amp; AS/NZS 5033/5139</a>
          <a href="/tools/solar-savings-calculator/">Solar Savings Calculator</a>
        </div>

        <p class="disclaimer">Rebate data verified against official government and regulator sources on {meta.last_verified}. Schemes change frequently — always confirm with the linked official source before committing to a purchase. TradieAutomate may earn a commission from some linked installers.</p>
      </div>

      <section class="sg">
        <h2>2026 rebate amounts, state by state</h2>
        <p class="sg-intro">Every program the finder checks, with the current amount and whether it is open. Last verified against official sources <strong>{meta.last_verified}</strong>. Use the finder above for eligibility specific to your customer's property.</p>
        {STATE_GROUPS.map(([st, label, items]) => (
          <div class="sg-block">
            <h3>{label}</h3>
            <ul>
              {items.map((p) => (
                <li>
                  <strong>{p.name}</strong>
                  <span class="sg-amt">{p.amount_range}</span>
                  {p.status === 'closed' && <span class="sg-closed">closed</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section class="sg sg-faq">
        <h2>Rebate finder: common questions</h2>
        <details>
          <summary>What is the best heat pump hot water rebate in Australia in 2026?</summary>
          <p>Victoria offers the largest state rebate: up to $1,000 via Solar Homes (up to $1,400 for locally-made systems) stacking with VEU discounts of up to $560. NSW offers up to $640 via the Energy Savings Scheme. Queensland has no state rebate — households get the federal STC discount of $500–$800 off the quote.</p>
        </details>
        <details>
          <summary>Are there solar and battery rebates in my state in 2026?</summary>
          <p>Victoria still offers the Solar Homes panel rebate (up to $1,400), but its battery interest-free loan is closed to new applications. NSW battery buyers use the Home Energy Saver program (up to $4,000 discount or $15,000 zero-interest loan). Queensland's Battery Booster closed in May 2024 — the federal Cheaper Home Batteries Program (~30% off) is the main battery incentive nationally.</p>
        </details>
        <details>
          <summary>Is the TradieAutomate rebate finder free?</summary>
          <p>Yes. The rebate finder is completely free — no email or sign-up. Rebate data is verified against official sources (Solar Victoria, NSW Climate and Energy Action, Service NSW, Clean Energy Regulator) on a weekly cycle.</p>
        </details>
      </section>
      <div class="tool-body" style="border-top:1px dashed #e2e8f0;padding-top:18px;margin-top:8px;">
        <NewsletterSignup variant="tool-exit" source="tool_exit" />
      </div>
    </main>

    <Footer />
    <script is:inline set:html={`window.__RF_DATA = ${rfDataJson};
window.__RF_SPONSORS = ${JSON.stringify({
  VIC: null, NSW: null, QLD: null, SA: null, WA: null, TAS: null, ACT: null, NT: null
}).replace(/</g, '\\u003c')};`}></script>
    <script is:inline>
      (function(){
        var QUIZ = document.getElementById('rf-quiz');
        var RESULTS = document.getElementById('rf-results');
        if(!QUIZ || !window.__RF_DATA) return;
        var PROGRAMS = window.__RF_DATA.programs;
        var steps = QUIZ.querySelectorAll('.pf-step');
        var answers = {state:'', category:'', owner:''};
        var current = 0;

        function showStep(n){
          steps.forEach(function(s,i){ s.classList.toggle('active', i===n); });
          current = n;
          var nav = QUIZ.querySelector('.pf-nav');
          if(nav) nav.style.display = (n>0) ? 'flex' : 'none';
        }

        function getMatches(){
          var list = [];
          var keys = Object.keys(PROGRAMS);
          for(var i=0;i<keys.length;i++){
            var p = PROGRAMS[keys[i]];
            if(p.status !== 'open') continue;
            // State match: state-specific programs match their state; ALL programs always match.
            var okState = (p.state==='ALL') ? true : (answers.state==='ALL' || p.state===answers.state);
            if(!okState) continue;
            var okCat = p.category.indexOf(answers.category) >= 0;
            if(!okCat) continue;
            list.push(p);
          }
          return list;
        }

        function render(){
          var matches = getMatches();
          var el = document.getElementById('rf-result-list');
          if(matches.length===0){
            el.innerHTML = '<div class="result-card"><h3>No open rebates found</h3><p class="note">No state rebate currently matches your selection. Federal programs still apply — check the list below, or try another upgrade type.</p></div>';
            renderFederal();
            return;
          }
          var html = '';
          for(var i=0;i<matches.length;i++){
            var p = matches[i];
            html += '<div class="result-card">';
            html += '<div class="rc-top"><h3>'+p.name+'</h3><div><span class="amt">'+p.amount_range.split('(')[0].trim()+'</span></div></div>';
            html += '<p class="note">'+p.amount_note+'</p>';
            if(p.eligibility && p.eligibility.length){
              html += '<ul class="elig-list">';
              for(var j=0;j<p.eligibility.length;j++){
                var miss = (answers.owner==='business' || answers.owner==='other') && p.eligibility[j].toLowerCase().indexOf('owner-occupier')>=0;
                html += '<li'+(miss?' class="miss"':'')+'>'+p.eligibility[j]+'</li>';
              }
              html += '</ul>';
            }
            if(p.expiry) html += '<p class="note" style="margin-top:10px;"><strong>⏳ Expiry:</strong> '+p.expiry+'</p>';
            if(p.how_to_claim) html += '<div class="claim-box">🗺️ '+p.how_to_claim+'</div>';
            html += '<p class="src-line">Source: <a href="'+p.source_url+'" target="_blank" rel="noopener">'+p.source_name+'</a></p>';
            html += '</div>';
          }
          el.innerHTML = html;
          renderFederal();
          renderSponsor();
          if(window.gtag){ gtag('event','rebate_finder_results',{state:answers.state||'none',category:answers.category||'none'}); }
        }

        function renderFederal(){
          var fedEl = document.getElementById('rf-federal') || document.querySelector('#rf-result-list .federal-block');
          var keys = Object.keys(PROGRAMS);
          var list = [];
          for(var i=0;i<keys.length;i++){ var p=PROGRAMS[keys[i]]; if(p.state==='ALL' && p.status==='open' && p.category.indexOf(answers.category)>=0) list.push(p); }
          if(list.length===0) return;
          var html = '<div class="federal-block" style="margin-top:18px;padding-top:16px;border-top:1px solid #e2e8f0;">';
          html += '<h3 style="font-size:1rem;color:#0f172a;margin-bottom:12px;">🇦🇺 Federal programs that also apply</h3>';
          for(var j=0;j<list.length;j++){
            var p=list[j];
            html += '<div class="result-card"><h3>'+p.name+'</h3><div class="amt">'+p.amount_range.split('(')[0].trim()+'</div><p class="note">'+p.amount_note+'</p><p class="src-line">Source: <a href="'+p.source_url+'" target="_blank" rel="noopener">'+p.source_name+'</a></p></div>';
          }
          html += '</div>';
          var mainEl = document.getElementById('rf-result-list');
          mainEl.insertAdjacentHTML('beforeend', html);
        }

        QUIZ.addEventListener('click', function(e){
          var b = e.target.closest('.pf-btn');
          if(!b) return;
          steps.forEach(function(s){ if(s.classList.contains('active')){} });
          var field = b.getAttribute('data-field');
          var val = b.getAttribute('data-value');
          var q = parseInt(b.getAttribute('data-step'), 10);
          answers[field] = val;
          b.classList.add('selected');
          if(q < 2){
            showStep(q+1);
          } else {
            showStep(2);
            QUIZ.style.display='none';
            RESULTS.style.display='block';
            var sum = document.getElementById('rf-summary');
            sum.textContent = 'Showing open '+answers.category.replace(/_/g,' ')+' rebates for '+(answers.state==='ALL'?'all states':answers.state)+' — plus federal programs.';
            render();
          }
        });

        var backBtn = document.getElementById('rf-back');
        if(backBtn){ backBtn.addEventListener('click', function(){ if(current>0){ showStep(current-1); } }); }

        function resetQuiz(){
          answers = {state:'', category:'', owner:''};
          current = 0;
          QUIZ.style.display = 'block';
          RESULTS.style.display = 'none';
          steps.forEach(function(s){ s.classList.remove('active'); });
          showStep(0);
          var sel = QUIZ.querySelectorAll('.pf-btn.selected');
          for(var i=0;i<sel.length;i++){ sel[i].classList.remove('selected'); }
          if(window.gtag){ gtag('event','rebate_finder_reset'); }
        }

        var resetBtn = document.getElementById('rf-reset');
        if(resetBtn){ resetBtn.addEventListener('click', resetQuiz); }

        var resultsReset = document.getElementById('rf-results-reset');
        if(resultsReset){ resultsReset.addEventListener('click', resetQuiz); }

        var sponsorSlot = document.getElementById('rf-sponsor-slot');
        function renderSponsor(){
          if(!sponsorSlot || !window.__RF_SPONSORS) return;
          var sp = window.__RF_SPONSORS[answers.state];
          if(sp && sp.name){
            sponsorSlot.innerHTML = '🏆 <strong>' + sp.name + '</strong> — ' + sp.offer + (sp.url ? ' <a href="' + sp.url + '" style="color:#0284c7;" rel="sponsored nofollow">Learn more →</a>' : '');
          } else {
            sponsorSlot.innerHTML = '📢 Sponsor slot — your rebate-eligible product or installer service could appear here (contact info@tradieautomate.com)';
          }
        }

        var tradieCta = document.getElementById('rf-tradie-cta');
        if(tradieCta){ tradieCta.addEventListener('click', function(e){
          if(window.gtag){ gtag('event', 'rebate_finder_lead', { event_category: 'engagement', event_label: 'installer_cta' }); }
          var form = document.getElementById('rf-lead-form');
          var label = document.getElementById('rf-lead-state-label');
          var stateInput = document.getElementById('rf-lead-state');
          var upgradeInput = document.getElementById('rf-lead-upgrade');
          if(form){
            form.style.display = 'block';
            if(label) label.textContent = (answers.state === 'ALL' || !answers.state) ? 'local' : answers.state;
            if(stateInput) stateInput.value = answers.state === 'ALL' || !answers.state ? '' : answers.state;
            if(upgradeInput) upgradeInput.value = answers.category || '';
            e.preventDefault();
            e.stopPropagation();
            if(window.gtag){ gtag('event','rebate_finder_lead_form_shown', { event_category:'engagement', event_label: answers.state || 'ALL' }); }
          }
        }); }

        var leadForm = document.getElementById('rf-lead-form-el');
        if(leadForm){ leadForm.addEventListener('submit', function(e){
          e.preventDefault();
          var name = document.getElementById('rf-lead-name').value.trim();
          var email = document.getElementById('rf-lead-email').value.trim();
          var postcode = (document.getElementById('rf-lead-postcode').value || '').trim();
          var state = document.getElementById('rf-lead-state').value;
          var upgrade = document.getElementById('rf-lead-upgrade').value;
          var msg = document.getElementById('rf-lead-msg');
          var err = document.getElementById('rf-lead-err');
          if(err) err.style.display = 'none';
          function done(ok){
            if(ok){
              if(msg) msg.style.display = 'block';
              if(window.gtag){ gtag('event','rebate_finder_lead_submit', { event_category:'conversion', event_label: state + ':' + upgrade }); }
            } else {
              if(err){ err.textContent = 'Something went wrong — email us at info@tradieautomate.com instead.'; err.style.display = 'block'; }
            }
          }
          fetch('/.netlify/functions/rebate-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, email: email, postcode: postcode, state: state, upgrade: upgrade })
          }).then(function(r){ return r.json(); }).then(function(d){ done(d && d.success); }).catch(function(){ done(false); });
        }); }
      })();
    </script>
  </body>
</html>