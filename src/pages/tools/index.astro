---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Free Tools for Australian Trade Businesses — ${SITE_TITLE}`} description="Free calculators for Australian solar installers and tradies. Know your job margin, calculate admin costs, and make data-driven business decisions." />
    <style>
      .tools-hero {
        text-align: center;
        padding: 48px 24px 32px;
      }
      .tools-hero h1 {
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 12px;
      }
      .tools-hero p {
        color: #64748b;
        max-width: 500px;
        margin: 0 auto;
        font-size: 1rem;
      }
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 40px;
      }
      .tool-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 28px;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.2s, transform 0.15s;
        display: block;
      }
      .tool-card:hover {
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        transform: translateY(-2px);
      }
      .tool-card .tool-icon { font-size: 2rem; margin-bottom: 12px; display: block; }
      .tool-card .tool-badge {
        display: inline-block;
        background: #fff7ed;
        color: #ea580c;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 3px 8px;
        border-radius: 100px;
        margin-bottom: 10px;
      }
      .tool-card h2 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
        line-height: 1.3;
      }
      .tool-card p {
        font-size: 0.88rem;
        color: #64748b;
        line-height: 1.55;
        margin-bottom: 16px;
      }
      .tool-card .tool-cta {
        font-size: 0.85rem;
        font-weight: 700;
        color: #f97316;
        display: flex;
        align-items: center;
        gap: 4px;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="tools-hero">
        <h1>Free Tools for Australian Tradies</h1>
        <p>Calculators built for solar installers, electricians, and trade business owners. Free, no sign-up required.</p>
      </div>
      <div class="tools-grid">
        <a href="/tools/solar-quote-calculator" class="tool-card">
          <span class="tool-icon">☀️</span>
          <span class="tool-badge">Solar Installers</span>
          <h2>Solar Quote Profitability Calculator</h2>
          <p>Know your net profit, margin %, and exact breakeven price before sending any quote. Includes STC auto-calculation by state, battery impact, and warranty reserve.</p>
          <span class="tool-cta">Use this tool →</span>
        </a>
        <a href="/tools/admin-cost-calculator" class="tool-card">
          <span class="tool-icon">🧮</span>
          <span class="tool-badge">All Trades</span>
          <h2>Tradie Admin Cost Calculator</h2>
          <p>Find out exactly how much unbillable admin is costing your business per year. Enter your charge-out rate, team size, and hours — takes 60 seconds.</p>
          <span class="tool-cta">Use this tool →</span>
        </a>
        <a href="/tools/tradie-brain" class="tool-card">
          <span class="tool-icon">🤖</span>
          <span class="tool-badge">Solar &amp; Electrical</span>
          <h2>Tradie Brain AI</h2>
          <p>Ask anything about CER audits, AS/NZS 5033 &amp; 5139, ServiceM8 setup, STC claims, CCEW lodgement, EV chargers and growing your trade business. Instant answers, no login.</p>
          <span class="tool-cta">Ask Tradie Brain →</span>
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
