---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import VisualGuide from '../../layouts/VisualGuide.astro';

export async function getStaticPaths() {
	const guides = await getCollection('visualGuides');
	return guides.map((guide) => ({
		params: { slug: guide.id },
		props: guide,
	}));
}
type Props = CollectionEntry<'visualGuides'>;

const guide = Astro.props;
const { Content } = await render(guide);
---

<VisualGuide {...guide.data}>
	<div class="prose-block"><Content /></div>
</VisualGuide>
