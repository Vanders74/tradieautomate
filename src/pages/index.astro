---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 6);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["ProfessionalService", "LocalBusiness"],
  "@id": `${SITE_URL}/#localbusiness`,
  "name": "TradieAutomate",
  "url": SITE_URL,
  "logo": `${SITE_URL}/favicon.svg`,
  "image": `${SITE_URL}/hero-home.webp`,
  "description": "Helping Australian electricians and solar installers run smarter businesses with ServiceM8 — scheduling, quoting, invoicing, and compliance on one platform.",
  "areaServed": { "@type": "Country", "name": "Australia" },
  "knowsAbout": [
    "ServiceM8 job management for electricians",
    "Solar compliance Australia",
    "CER accreditation",
    "AS/NZS 3000 electrical wiring rules",
    "AS/NZS 5033 solar installation standard",
    "AS/NZS 5139 battery storage standard",
    "CCEW NSW compliance",
    "STC documentation"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "TradieAutomate Resources",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ServiceM8 Setup Guides", "description": "Step-by-step guides for Australian electricians setting up ServiceM8 for scheduling, quoting, compliance, and invoicing." }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sparky's Playbook", "description": "Free 12-chapter PDF guide covering compliance, cash flow, scaling, and exit strategy for Australian electrical contractors." }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Free Tools & Calculators", "description": "Solar savings calculator, admin cost calculator, EV charger quote tool, and Tradie Brain AI assistant." }}
    ]
  },
  "sameAs": [
    "https://www.instagram.com/tradieautomate/",
    "https://www.facebook.com/profile.php?id=61585208957817"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="TradieAutomate — ServiceM8 Guides & Tools for Australian Electricians"
      description="ServiceM8 helps Australian electricians schedule jobs, send quotes, invoice faster, and handle CCEW compliance from one app. Free guides, tools, and a 14-day trial."
    />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body>
    <!-- Sticky Bar — Playbook -->
    <div class="sticky-bar" id="stickyBar" role="complementary" aria-label="Free Sparky's Playbook">
      <span class="sticky-bar-text">
        📘 <strong>Free Download:</strong> The Sparky's Playbook — 12 chapters for Australian electricians
      </span>
      <a href="/playbook" class="sticky-bar-cta">Get the Free Guide →</a>
      <button class="sticky-bar-close" aria-label="Dismiss" onclick="document.getElementById('stickyBar').style.display='none'">✕</button>
    </div>

    <Header />
    <main>

      <!-- ── HERO: ServiceM8-focused ── -->
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-inner">
          <div class="hero-text">
            <p class="hero-eyebrow">For Australian Electrical Contractors</p>
            <h1 id="hero-heading">
              The Job Management Platform<br />
              <span class="highlight">Australian Electricians<br />Actually Use</span>
            </h1>
            <p class="hero-sub">
              ServiceM8 handles scheduling, quoting, invoicing, and CCEW compliance certificates — so you finish on-site, not at 9 PM. Built in Australia. Used by thousands of sparkies.
            </p>
            <div class="hero-cta-group">
              <a href="https://www.servicem8.com/?ref=tradieautomate&utm_source=tradieautomate&utm_medium=blog&utm_campaign=affiliate&utm_content=homepage-hero" class="cta-primary">
                Start Free 14-Day Trial →
              </a>
              <a href="/blog/servicem8-review-2026" class="cta-secondary">
                Read the Full Review →
              </a>
            </div>
            <p class="hero-trust">No credit card • Cancel anytime • Australian support</p>
          </div>
          <div class="hero-image" aria-hidden="true">
            <img
              src="/hero-servicem8-for-electricians.jpg"
              alt="Australian electrician using ServiceM8 on tablet at a job site"
              width="560" height="420"
              loading="eager" fetchpriority="high"
            />
          </div>
        </div>
      </section>

      <!-- ── PROOF: 3 reasons in 3 columns ── -->
      <section class="proof" aria-labelledby="proof-heading">
        <h2 id="proof-heading" class="proof-title">Why Australian Electricians Choose ServiceM8</h2>
        <div class="proof-grid">
          <div class="proof-card">
            <div class="proof-icon">📋</div>
            <h3>CCEW Compliance Built In</h3>
            <p>Digital forms completed on-site. Custom templates for every state — NSW CCEW, VIC CES, QLD Electrical Safety Certificate. Compliance paperwork done before you pack up.</p>
          </div>
          <div class="proof-card">
            <div class="proof-icon">⚡</div>
            <h3>Same-Day Invoicing</h3>
            <p>Invoice auto-generates at job completion. Payment link lands in the customer's inbox immediately. No chasing. No Friday afternoon phone calls. Xero syncs automatically.</p>
          </div>
          <div class="proof-card">
            <div class="proof-icon">💰</div>
            <h3>$29/Month Starting</h3>
            <p>Per-job pricing — not per-user. Hire your 5th electrician and your software cost stays flat. For a 2-person crew, ServiceM8 pays for itself in the first week through faster invoicing.</p>
          </div>
        </div>
      </section>

      <!-- ── TRUST STRIP ── -->
      <section class="trust-strip" aria-label="Trust indicators">
        <div class="trust-item"><span class="trust-icon">🇦🇺</span> Australian-built &amp; supported</div>
        <div class="trust-item"><span class="trust-icon">📱</span> iOS &amp; Android apps for field use</div>
        <div class="trust-item"><span class="trust-icon">🔗</span> Xero &amp; MYOB integration</div>
        <div class="trust-item"><span class="trust-icon">🛡️</span> 14-day free trial, no card</div>
      </section>

      <!-- ── CONTENT HUB: Explore guides ── -->
      <section class="content-hub" aria-labelledby="hub-heading">
        <h2 id="hub-heading">108+ Free Guides for Australian Electricians</h2>
        <p class="hub-sub">Everything you need to run a smarter electrical business — compliance, software, pricing, and growth. All free.</p>
        <div class="hub-grid">
          <a href="/blog/category/compliance/" class="hub-card">
            <span class="hub-icon">📋</span>
            <strong>Compliance &amp; Licensing</strong>
            <span>State licences, CCEW, AS/NZS standards, CER audits</span>
          </a>
          <a href="/blog/category/software-comparisons/" class="hub-card">
            <span class="hub-icon">⚡</span>
            <strong>Software Comparisons</strong>
            <span>ServiceM8 vs simPRO, Tradify, Fergus, AroFlo — honest reviews</span>
          </a>
          <a href="/blog/category/solar-battery/" class="hub-card">
            <span class="hub-icon">☀️</span>
            <strong>Solar &amp; Battery</strong>
            <span>STC claims, commercial solar, battery storage compliance</span>
          </a>
          <a href="/tools" class="hub-card">
            <span class="hub-icon">🧮</span>
            <strong>Free Tools &amp; Calculators</strong>
            <span>Solar savings, admin cost, EV charger quote, Tradie Brain AI</span>
          </a>
          <a href="/blog/category/business-growth/" class="hub-card">
            <span class="hub-icon">📈</span>
            <strong>Business Growth</strong>
            <span>Quoting, cash flow, hiring, scaling, and exit strategy</span>
          </a>
          <a href="/playbook" class="hub-card hub-card--featured">
            <span class="hub-icon">📘</span>
            <strong>Sparky's Playbook — Free PDF</strong>
            <span>12 chapters. 30,000 words. The complete guide.</span>
          </a>
        </div>
      </section>

      <!-- ── LEAD MAGNETS ── -->
      <section class="lead-magnets" aria-labelledby="leads-heading">
        <h2 id="leads-heading">Free Downloads for Your Business</h2>
        <div class="leads-grid">
          <a href="/playbook" class="lead-card">
            <span class="lead-tag">Free PDF</span>
            <h3>The Sparky's Playbook</h3>
            <p>12-chapter guide covering licensing, EV charging, commercial solar, cash flow, hiring, and exit strategy. 30,000 words. No fluff.</p>
            <span class="lead-cta">Download Free →</span>
          </a>
          <a href="/compliance-checklist" class="lead-card">
            <span class="lead-tag">Free PDF</span>
            <h3>2026 Solar Compliance Checklist</h3>
            <p>CER rules, AS/NZS 5033 &amp; 5139, STC documentation — one printable page covering every compliance requirement.</p>
            <span class="lead-cta">Download Free →</span>
          </a>
          <a href="/award-rates-card" class="lead-card">
            <span class="lead-tag">Free PDF</span>
            <h3>Award Rates Quick Reference Card</h3>
            <p>MA000025 rates on one page. ET grades, apprentice percentages, overtime rules, tool &amp; industry allowances. Updated July 2026.</p>
            <span class="lead-cta">Download Free →</span>
          </a>
        </div>
      </section>

      <!-- ── CLOSING CTA ── -->
      <section class="closing-cta" aria-labelledby="closing-heading">
        <div class="closing-inner">
          <h2 id="closing-heading">Ready to Try ServiceM8?</h2>
          <p>14 days free. No credit card. Set up your first compliance form template and run one real job through it — you'll know by day 10 whether it fits.</p>
          <a href="https://www.servicem8.com/?ref=tradieautomate&utm_source=tradieautomate&utm_medium=blog&utm_campaign=affiliate&utm_content=homepage-closing" class="cta-primary cta-large">
            Start Free Trial →
          </a>
        </div>
      </section>

      <!-- ── LATEST ARTICLES ── -->
      {posts.length > 0 && (
        <section class="latest-posts" aria-labelledby="articles-heading">
          <h2 id="articles-heading">Latest Articles</h2>
          <p class="section-sub">New guides every week on ServiceM8, compliance, software comparisons, and trade business growth.</p>
          <div class="post-grid">
            {posts.map((post) => (
              <a href={`/blog/${post.id}/`} class="post-card">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    width="360" height="200"
                    loading="lazy"
                    class="post-thumb"
                  />
                )}
                <div class="post-text">
                  <span class="post-category">{post.data.category || 'Guide'}</span>
                  <h3>{post.data.title}</h3>
                  <p class="post-desc">{post.data.description}</p>
                </div>
              </a>
            ))}
          </div>
          <a href="/blog" class="see-all">See all 108 articles →</a>
        </section>
      )}

    </main>
    <Footer />
  </body>
</html>

<style>
  /* ── Sticky Bar ── */
  .sticky-bar {
    position: sticky; top: 60px; z-index: 90;
    background: #0f172a; border-bottom: 3px solid #f97316;
    display: flex; align-items: center; justify-content: center;
    gap: 1em; padding: 0.6em 1.5em; flex-wrap: wrap;
  }
  .sticky-bar-text { color: rgba(255,255,255,0.9); font-size: 0.88em; }
  .sticky-bar-text strong { color: white; }
  .sticky-bar-cta {
    background: #f97316; color: white; padding: 0.35em 0.9em;
    border-radius: 5px; text-decoration: none; font-weight: 700; font-size: 0.85em;
    white-space: nowrap; transition: background 0.2s;
  }
  .sticky-bar-cta:hover { background: #c2410c; }
  .sticky-bar-close {
    background: none; border: none; color: rgba(255,255,255,0.5);
    font-size: 1em; cursor: pointer; padding: 0.2em 0.4em;
    margin-left: auto; flex-shrink: 0; line-height: 1;
  }
  .sticky-bar-close:hover { color: white; }

  /* ── Hero ── */
  .hero { padding: 3em 0 3.5em; }
  .hero-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3em;
    align-items: center; max-width: 1100px; margin: 0 auto; padding: 0 1.5em;
  }
  .hero-eyebrow {
    font-size: 0.8em; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: #f97316; margin: 0 0 0.75em;
  }
  .hero h1 { font-size: 2.6em; line-height: 1.15; margin-bottom: 0.45em; color: #0f172a; }
  .highlight { color: #f97316; }
  .hero-sub { font-size: 1.05em; color: #475569; line-height: 1.55; margin-bottom: 1.5em; max-width: 520px; }
  .hero-cta-group { display: flex; gap: 1em; flex-wrap: wrap; margin-bottom: 0.75em; }
  .cta-primary {
    display: inline-block; background: #f97316; color: white;
    padding: 0.75em 1.6em; border-radius: 8px; font-weight: 700; font-size: 1em;
    text-decoration: none; transition: background 0.2s, transform 0.1s;
  }
  .cta-primary:hover { background: #c2410c; transform: translateY(-1px); }
  .cta-secondary {
    display: inline-block; border: 2px solid #0f172a; color: #0f172a;
    padding: 0.7em 1.5em; border-radius: 8px; font-weight: 700; font-size: 1em;
    text-decoration: none; transition: background 0.2s;
  }
  .cta-secondary:hover { background: #0f172a; color: white; }
  .cta-large { padding: 0.9em 2.2em; font-size: 1.1em; }
  .hero-trust { font-size: 0.85em; color: #64748b; }
  .hero-image img { width: 100%; height: auto; border-radius: 12px; }

  /* ── Proof ── */
  .proof { padding: 3em 0 3.5em; background: #f8fafc; }
  .proof-title { text-align: center; font-size: 1.5em; color: #0f172a; margin-bottom: 1.5em; }
  .proof-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5em;
    max-width: 1000px; margin: 0 auto; padding: 0 1.5em;
  }
  .proof-card {
    background: white; border-radius: 12px; padding: 2em 1.5em;
    border: 1px solid #e2e8f0; text-align: center;
  }
  .proof-icon { font-size: 2.2em; margin-bottom: 0.5em; }
  .proof-card h3 { font-size: 1.1em; color: #0f172a; margin-bottom: 0.5em; }
  .proof-card p { font-size: 0.9em; color: #475569; line-height: 1.55; }

  /* ── Trust Strip ── */
  .trust-strip {
    display: flex; justify-content: center; gap: 2.5em; flex-wrap: wrap;
    padding: 1.5em 1.5em; background: #0f172a;
  }
  .trust-item { color: rgba(255,255,255,0.85); font-size: 0.9em; display: flex; align-items: center; gap: 0.4em; }
  .trust-icon { font-size: 1.1em; }

  /* ── Content Hub ── */
  .content-hub { padding: 3.5em 1.5em; max-width: 1000px; margin: 0 auto; }
  .content-hub h2 { text-align: center; font-size: 1.5em; color: #0f172a; margin-bottom: 0.3em; }
  .hub-sub { text-align: center; color: #64748b; margin-bottom: 2em; }
  .hub-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1em;
  }
  .hub-card {
    background: white; border: 1px solid #e2e8f0; border-radius: 10px;
    padding: 1.5em 1.2em; text-decoration: none; color: inherit;
    transition: box-shadow 0.2s, transform 0.1s;
    display: flex; flex-direction: column; gap: 0.3em;
  }
  .hub-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }
  .hub-card--featured { border-color: #f97316; background: #fff7ed; }
  .hub-icon { font-size: 1.4em; }
  .hub-card strong { font-size: 0.95em; color: #0f172a; }
  .hub-card span { font-size: 0.82em; color: #64748b; line-height: 1.4; }

  /* ── Lead Magnets ── */
  .lead-magnets { padding: 3em 1.5em; background: #f8fafc; }
  .lead-magnets h2 { text-align: center; font-size: 1.5em; color: #0f172a; margin-bottom: 1.5em; }
  .leads-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5em;
    max-width: 1000px; margin: 0 auto;
  }
  .lead-card {
    background: white; border-radius: 12px; padding: 1.8em;
    border: 1px solid #e2e8f0; text-decoration: none; color: inherit;
    transition: box-shadow 0.2s, transform 0.1s;
    display: flex; flex-direction: column;
  }
  .lead-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.08); transform: translateY(-2px); }
  .lead-tag {
    display: inline-block; background: #fef3c7; color: #92400e; font-size: 0.7em;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    padding: 0.25em 0.7em; border-radius: 100px; margin-bottom: 0.8em; width: fit-content;
  }
  .lead-card h3 { font-size: 1.05em; color: #0f172a; margin-bottom: 0.4em; }
  .lead-card p { font-size: 0.88em; color: #475569; line-height: 1.5; flex: 1; }
  .lead-cta { font-size: 0.85em; font-weight: 700; color: #f97316; margin-top: 0.75em; }

  /* ── Closing CTA ── */
  .closing-cta { padding: 3.5em 1.5em; }
  .closing-inner {
    max-width: 600px; margin: 0 auto; text-align: center;
    background: #0f172a; color: white; border-radius: 14px; padding: 2.5em 2em;
  }
  .closing-inner h2 { color: white; font-size: 1.5em; margin-bottom: 0.5em; }
  .closing-inner p { color: rgba(255,255,255,0.75); font-size: 0.95em; line-height: 1.55; margin-bottom: 1.5em; }
  .closing-inner .cta-primary { background: #f97316; }

  /* ── Latest Articles ── */
  .latest-posts { padding: 3em 1.5em 4em; max-width: 1100px; margin: 0 auto; }
  .latest-posts h2 { text-align: center; font-size: 1.5em; color: #0f172a; margin-bottom: 0.3em; }
  .section-sub { text-align: center; color: #64748b; margin-bottom: 2em; }
  .post-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5em;
  }
  .post-card {
    background: white; border: 1px solid #e2e8f0; border-radius: 12px;
    overflow: hidden; text-decoration: none; color: inherit;
    transition: box-shadow 0.2s, transform 0.1s;
  }
  .post-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }
  .post-thumb { width: 100%; height: 180px; object-fit: cover; }
  .post-text { padding: 1em 1.2em 1.2em; }
  .post-category {
    font-size: 0.7em; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: #f97316; margin-bottom: 0.3em; display: block;
  }
  .post-card h3 { font-size: 0.95em; color: #0f172a; line-height: 1.3; margin-bottom: 0.3em; }
  .post-desc { font-size: 0.82em; color: #64748b; line-height: 1.45; }
  .see-all {
    display: block; text-align: center; margin-top: 2em;
    font-weight: 700; color: #f97316; text-decoration: none;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2em; }
    .hero h1 { font-size: 1.9em; }
    .proof-grid { grid-template-columns: 1fr; }
    .hub-grid { grid-template-columns: repeat(2, 1fr); }
    .leads-grid { grid-template-columns: 1fr; }
    .post-grid { grid-template-columns: 1fr; }
    .trust-strip { gap: 1.2em; }
  }
  @media (max-width: 480px) {
    .hub-grid { grid-template-columns: 1fr; }
  }
</style>
