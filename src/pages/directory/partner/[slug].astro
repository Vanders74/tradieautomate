---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import directory from '../../../data/directory.json';

export function getStaticPaths() {
  return directory.listings
    .filter((l) => l.status === 'live')
    .map((l) => ({ params: { slug: l.slug }, props: { listing: l } }));
}

const { listing } = Astro.props;
const all = directory.listings.filter((l) => l.status === 'live');
const related = all.filter((l) => l.state === listing.state && l.slug !== listing.slug).slice(0, 3);
const title = `${listing.name} — ServiceM8 Partner in ${listing.city}, ${listing.state} | TradieAutomate`;
const description = listing.summary.slice(0, 158);
const claimHref = `mailto:info@tradieautomate.com?subject=${encodeURIComponent('Claim listing: ' + listing.name)}&body=${encodeURIComponent(`Business name: ${listing.name}\nState: ${listing.state}\nWebsite:\nWhat we do:\n`)}`;
const hasSite = Boolean(listing.website_direct);
const primaryHref = listing.website_direct || listing.official_profile;
const primaryLabel = hasSite ? 'Visit website' : 'Contact via ServiceM8';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: listing.name,
  description: listing.summary,
  url: primaryHref,
  areaServed: { '@type': 'State', name: listing.state },
  address: { '@type': 'PostalAddress', addressLocality: listing.city, addressRegion: listing.state, addressCountry: 'AU' },
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Directory', item: 'https://tradieautomate.com/directory/' },
    { '@type': 'ListItem', position: 2, name: listing.state, item: `https://tradieautomate.com/directory/${listing.state.toLowerCase()}/` },
    { '@type': 'ListItem', position: 3, name: listing.name, item: `https://tradieautomate.com/directory/partner/${listing.slug}/` },
  ],
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="wrap">
          <nav class="crumbs">
            <a href="/directory/">Directory</a> /
            <a href={`/directory/${listing.state.toLowerCase()}/`}>{listing.state}</a> /
            <span>{listing.name}</span>
          </nav>
          <div class="identity">
            {listing.logo ? <img src={listing.logo} alt={`${listing.name} logo`} width="72" height="72" /> : <span class="fallback">{listing.name.slice(0,1)}</span>}
            <div>
              <h1>{listing.name}</h1>
              <p class="loc">{listing.city}, {listing.state} · ServiceM8 provider</p>
              <div class="pills">
                {listing.tier !== 'free' ? <span class="pill paid">Featured partner</span> : <span class="pill">Verified listing</span>}
                <span class="pill verified">Checked {listing.verified_at}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="wrap body">
        <div class="cols">
          <div class="main">
            <h2>What they do</h2>
            <p class="summary">{listing.summary}</p>

            <h2>Services</h2>
            <ul class="services">
              {listing.services.map((s) => <li>{s}</li>)}
            </ul>

            <h2>Who they work with</h2>
            <p>
              Trade and service businesses in {listing.city} and across {listing.state} — electrical, plumbing,
              HVAC, solar and general contracting — looking for help implementing or improving ServiceM8.
            </p>

            <h2>Before you call them</h2>
            <p class="intro">Five questions that separate a good implementation from an expensive one:</p>
            <ol class="asks">
              <li>Who actually does the work — the person you're speaking to, or a subcontractor?</li>
              <li>What's included in the fixed price, and what gets billed as a variation?</li>
              <li>How many trades businesses of my size have you set up, and can I speak to one?</li>
              <li>Who trains my team, how many hours, and what happens after go-live?</li>
              <li>If we stop working together, who owns the forms, automations and documentation?</li>
            </ol>

            <h2>Contact</h2>
            <p class="contact">
              <a class="btn" href={primaryHref} target="_blank" rel="nofollow noopener">{primaryLabel} →</a>
              {hasSite && <a class="btn ghost" href={listing.official_profile} target="_blank" rel="nofollow noopener">ServiceM8 profile</a>}
            </p>
            <p class="fine">
              Outbound links are nofollow. TradieAutomate does not take a commission on work booked through this
              directory, and is not endorsed by ServiceM8.
            </p>

            <div class="review-box">
              <strong>Still deciding on the software?</strong>
              <p>Read our <a href="/blog/servicem8-review-2026/">independent ServiceM8 review</a> — pricing, what it does well, and where it falls short for small crews. Comparing plans first? See the <a href="/blog/servicem8-pricing-plans-australia-2026/">2026 pricing breakdown</a>.</p>
            </div>

            <h2>Want an introduction?</h2>
            <p>
              Tell us your trade, state and what you need help with and we'll introduce you to up to three suitable
              providers, including this one.
            </p>
            <p><a class="btn" href="/directory/get-matched/">Request an introduction</a></p>
          </div>

          <aside class="side">
            <div class="box">
              <h3>Listing details</h3>
              <dl>
                <dt>Location</dt><dd>{listing.city}, {listing.state}</dd>
                <dt>Categories</dt><dd>{listing.categories.map((c) => c.replace(/-/g, ' ')).join(', ')}</dd>
                <dt>Services</dt><dd>{listing.services.join(', ')}</dd>
                <dt>Last checked</dt><dd>{listing.verified_at}</dd>
                <dt>Source</dt><dd>{listing.verification_source}</dd>
              </dl>
            </div>
            <div class="box claim">
              <h3>Is this your business?</h3>
              <p>Claim the listing free to correct details and receive introduction requests.</p>
              <a class="btn" href={claimHref}>Claim this listing</a>
            </div>
          </aside>
        </div>

        {related.length > 0 && (
          <section class="related">
            <h2>Other providers in {listing.state}</h2>
            <div class="relgrid">
              {related.map((r) => (
                <a class="rel" href={`/directory/partner/${r.slug}/`}>
                  <span class="relhead">
                    {r.logo ? <img src={r.logo} alt="" width="36" height="36" loading="lazy" /> : <span class="relfallback">{r.name.slice(0,1)}</span>}
                    <strong>{r.name}</strong>
                  </span>
                  <span class="relloc">{r.city}, {r.state}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </main>

    <div class="mobile-cta">
      <a class="btn" href={primaryHref} target="_blank" rel="nofollow noopener">{primaryLabel}</a>
      <a class="btn ghost" href="/directory/get-matched/">Get matched</a>
    </div>

    <Footer />
    <style>
      .wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
      .hero { background: radial-gradient(900px 340px at 30% -20%, #1c3a5e 0%, #0b1220 65%); color: #e2e8f0; padding: 40px 0 34px; }
      .crumbs { font-size: .78rem; color: #94a3b8; margin-bottom: 16px; }
      .crumbs a { color: #38bdf8; text-decoration: none; }
      .identity { display: flex; gap: 18px; align-items: center; }
      .identity img { width: 72px; height: 72px; object-fit: contain; background: #fff; border-radius: 12px; padding: 6px; }
      .fallback { width: 72px; height: 72px; border-radius: 12px; background: #1e293b; display: grid; place-items: center; font-size: 1.6rem; font-weight: 800; color: #94a3b8; }
      .hero h1 { color: #fff; font-size: clamp(1.5rem, 3.4vw, 2.15rem); margin: 0 0 4px; letter-spacing: -.01em; }
      .loc { color: #94a3b8; margin: 0 0 10px; font-size: .92rem; }
      .pills { display: flex; gap: 8px; flex-wrap: wrap; }
      .pill { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; background: #16233a; border: 1px solid #334155; color: #cbd5e1; padding: 4px 9px; border-radius: 999px; }
      .pill.verified { border-color: #0f766e; color: #5eead4; }
      .pill.paid { background: #0f766e; border-color: #0f766e; color: #fff; }
      .body { padding: 34px 20px 80px; }
      .cols { display: grid; grid-template-columns: 1fr 310px; gap: 34px; }
      h2 { font-size: 1.15rem; color: #0f172a; margin: 30px 0 10px; letter-spacing: -.01em; }
      .summary { color: #334155; line-height: 1.75; font-size: 1.02rem; }
      .services { color: #334155; line-height: 1.75; padding-left: 20px; }
      .intro { color: #475569; }
      .asks { color: #334155; line-height: 1.7; padding-left: 22px; }
      .asks li { margin-bottom: 8px; }
      .contact { display: flex; gap: 10px; flex-wrap: wrap; }
      .btn { display: inline-block; background: #0ea5e9; color: #062033; padding: 12px 20px; border-radius: 8px; font-weight: 800; text-decoration: none; }
      .btn.ghost { background: #fff; border: 1px solid #cbd5e1; color: #0f172a; }
      .fine { color: #64748b; font-size: .78rem; line-height: 1.6; }
      .review-box { margin: 26px 0; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; }
      .review-box strong { color: #0f172a; }
      .review-box p { margin: 6px 0 0; color: #475569; font-size: .9rem; line-height: 1.6; }
      .review-box a { color: #0284c7; font-weight: 700; }
      .box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 14px; }
      .box h3 { margin: 0 0 10px; font-size: .98rem; }
      dl { margin: 0; font-size: .84rem; }
      dt { color: #64748b; margin-top: 9px; }
      dd { margin: 2px 0 0; color: #0f172a; line-height: 1.4; }
      .box.claim { background: #0b1220; border-color: #0b1220; color: #e2e8f0; }
      .box.claim h3 { color: #fff; }
      .box.claim p { color: #b6c2d4; font-size: .86rem; }
      .related { margin-top: 46px; border-top: 1px solid #e2e8f0; padding-top: 8px; }
      .relgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; }
      .rel { display: flex; flex-direction: column; gap: 6px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; text-decoration: none; }
      .relhead { display: flex; align-items: center; gap: 10px; }
      .relhead img { width: 36px; height: 36px; object-fit: contain; border-radius: 6px; background: #f8fafc; }
      .relfallback { width: 36px; height: 36px; border-radius: 6px; background: #e2e8f0; display: grid; place-items: center; font-weight: 800; color: #475569; }
      .rel strong { color: #0f172a; font-size: .9rem; }
      .relloc { color: #64748b; font-size: .78rem; }
      .mobile-cta { display: none; }
      @media (max-width: 760px) {
        .cols { grid-template-columns: 1fr; }
        .identity img, .fallback { width: 56px; height: 56px; }
        .mobile-cta { display: flex; gap: 8px; position: sticky; bottom: 0; background: #fff; border-top: 1px solid #e2e8f0; padding: 10px 14px; z-index: 30; }
        .mobile-cta .btn { flex: 1; text-align: center; }
      }
    </style>
  </body>
</html>
