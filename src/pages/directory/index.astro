---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import directory from '../../data/directory.json';

const listings = directory.listings.filter((l) => l.status === 'live');
const states = [
  { key: 'nsw', label: 'New South Wales', code: 'NSW' },
  { key: 'vic', label: 'Victoria', code: 'VIC' },
  { key: 'qld', label: 'Queensland', code: 'QLD' },
].map((s) => ({ ...s, count: listings.filter((l) => l.state === s.code).length }));
const categories = [
  { key: 'servicem8-partners', label: 'ServiceM8 partners', blurb: 'Setup, training and ongoing support' },
  { key: 'servicem8-developers', label: 'ServiceM8 developers', blurb: 'Custom add-ons, API work and integrations' },
  { key: 'accountants-bookkeepers', label: 'Accountants & bookkeepers', blurb: 'Trade-savvy books inside ServiceM8' },
].map((c) => ({ ...c, count: listings.filter((l) => l.categories.includes(c.key)).length }));
const title = 'ServiceM8 Partner Directory Australia 2026 | TradieAutomate';
const description = 'Independent directory of Australian ServiceM8 partners, developers and trade-savvy accountants. Compare local providers, request an introduction, or claim your free listing.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ServiceM8 Partner Directory Australia 2026',
  numberOfItems: listings.length,
  itemListElement: listings.slice(0, 20).map((l, i) => ({
    '@type': 'ListItem', position: i + 1, name: l.name,
    url: `https://tradieautomate.com/directory/partner/${l.slug}/`,
  })),
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow">Independent · {listings.length} verified providers</p>
          <h1>Find a ServiceM8 partner who knows your trade</h1>
          <p class="sub">
            Compare partners, developers and trade accountants across NSW, VIC and QLD.
            See what they actually do, then ask us for an introduction.
          </p>
          <div class="searchbar">
            <input id="q" type="search" placeholder="Search by name, city or specialty" aria-label="Search providers" />
            <button type="button" id="searchBtn">Search</button>
          </div>
          <div class="stats">
            <span><strong>{listings.length}</strong> providers</span>
            <span><strong>{states.length}</strong> states</span>
            <span><strong>Free</strong> basic listing</span>
          </div>
        </div>
      </section>

      <div class="filters">
        <div class="wrap fwrap">
          <select id="state" aria-label="Filter by state">
            <option value="">All states</option>
            {states.map((s) => <option value={s.code}>{s.label} ({s.count})</option>)}
          </select>
          <select id="cat" aria-label="Filter by category">
            <option value="">All categories</option>
            {categories.map((c) => <option value={c.key}>{c.label} ({c.count})</option>)}
          </select>
          <span class="result" id="count">{listings.length} providers</span>
        </div>
      </div>

      <div class="wrap body">
        <section class="browse">
          <h2>Browse by state</h2>
          <div class="statecards">
            {states.map((s) => (
              <a class="statecard" href={`/directory/${s.key}/`}>
                <strong>{s.label}</strong>
                <span>{s.count} providers</span>
                <em>View →</em>
              </a>
            ))}
          </div>
          <h2>Browse by category</h2>
          <div class="catrow">
            {categories.map((c) => (
              <a class="catchip" href={`/directory/${c.key}/`}>
                <strong>{c.label}</strong>
                <span>{c.blurb} · {c.count}</span>
              </a>
            ))}
          </div>
        </section>

        <section id="results">
          <div class="sechead">
            <h2>All providers</h2>
            <p>Listed from ServiceM8's public partner and developer directories. Featured placements are labelled.</p>
          </div>
          <div class="grid" id="grid">
            {listings.map((l) => (
              <article class="card" data-state={l.state} data-cats={l.categories.join(' ')} data-name={`${l.name} ${l.city} ${l.services.join(' ')}`.toLowerCase()}>
                <div class="card-head">
                  {l.logo ? <img src={l.logo} alt="" width="44" height="44" loading="lazy" /> : <span class="logo-fallback">{l.name.slice(0, 1)}</span>}
                  <div>
                    <h3><a href={`/directory/partner/${l.slug}/`}>{l.name}</a></h3>
                    <p class="loc">{l.city}, {l.state}</p>
                  </div>
                </div>
                <p class="desc">{(l.positioning || l.summary).slice(0, 132)}…</p>
                <div class="tags">
                  {(l.specialties && l.specialties.length ? l.specialties : l.services).slice(0, 2).map((s) => <span>{s}</span>)}
                </div>
                <div class="card-foot">
                  <span class={`badge ${l.tier === 'free' ? 'muted' : 'paid'}`}>{l.tier === 'free' ? 'Verified listing' : 'Featured'}</span>
                  <a class="view" href={`/directory/partner/${l.slug}/`}>View profile →</a>
                </div>
              </article>
            ))}
          </div>
          <p class="empty" id="empty" hidden>No providers match that search. Try a different state or category.</p>
        </section>

        <section class="review-callout">
          <div>
            <h2>Not sure ServiceM8 is the right fit?</h2>
            <p>Read our independent review first — pricing, pros and cons, and where it breaks down for small crews.</p>
          </div>
          <a class="btn light" href="/blog/servicem8-review-2026/">Read the ServiceM8 review →</a>
        </section>

        <section class="how">
          <h2>How this works</h2>
          <div class="steps">
            <div><span>1</span><strong>Compare</strong><p>Every listing shows what the provider does, where they work and when we last checked it.</p></div>
            <div><span>2</span><strong>Get matched</strong><p>Tell us your trade, state and problem. We send it to up to three suitable providers.</p></div>
            <div><span>3</span><strong>Choose</strong><p>You deal with them directly. We take no commission and don't sell your details.</p></div>
          </div>
        </section>

        <section id="claim" class="claim">
          <div>
            <h2>Is this your business?</h2>
            <p>Basic listings are free. Claim yours to correct your details, add specialties and receive introduction requests from tradies in your state.</p>
          </div>
          <div class="claim-actions">
            <a class="btn" href="mailto:info@tradieautomate.com?subject=Claim%20my%20directory%20listing&body=Business%20name%3A%0AState%3A%0AWebsite%3A%0AWhat%20you%20do%3A%0A">Claim your listing</a>
            <a class="btn ghost" href="/directory/get-matched/">Request an introduction</a>
          </div>
          <p class="fine">
            TradieAutomate is independent and not endorsed by ServiceM8. Listings are compiled from ServiceM8's public
            partner and developer directories and each provider's own public information. We do not charge for a basic
            listing, and outbound links are marked nofollow.
          </p>
        </section>
      </div>
    </main>
    <Footer />

    <script is:inline>
      const q = document.getElementById('q');
      const st = document.getElementById('state');
      const cat = document.getElementById('cat');
      const cards = [...document.querySelectorAll('#grid .card')];
      const count = document.getElementById('count');
      const empty = document.getElementById('empty');
      function apply() {
        const term = q.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach((c) => {
          const ok = (!term || c.dataset.name.includes(term)) &&
            (!st.value || c.dataset.state === st.value) &&
            (!cat.value || c.dataset.cats.includes(cat.value));
          c.hidden = !ok;
          if (ok) shown++;
        });
        count.textContent = shown + (shown === 1 ? ' provider' : ' providers');
        empty.hidden = shown !== 0;
      }
      [q, st, cat].forEach((el) => el.addEventListener('input', apply));
      q.addEventListener('keydown', (e) => { if (e.key === 'Enter') document.getElementById('results').scrollIntoView({ behavior: 'smooth' }); });
      document.getElementById('searchBtn').addEventListener('click', () => {
        document.getElementById('results').scrollIntoView({ behavior: 'smooth' }); apply();
      });
    </script>

    <style>
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      .hero { background: radial-gradient(1200px 420px at 50% -10%, #1c3a5e 0%, #0b1220 62%); color: #e2e8f0; padding: 64px 0 40px; text-align: center; }
      .eyebrow { color: #38bdf8; text-transform: uppercase; letter-spacing: .14em; font-size: .7rem; font-weight: 800; margin: 0 0 10px; }
      .hero h1 { color: #fff; font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.12; margin: 0 auto 14px; max-width: 760px; letter-spacing: -.02em; }
      .sub { color: #9fb0c7; max-width: 600px; margin: 0 auto; line-height: 1.65; font-size: 1.02rem; }
      .searchbar { display: flex; gap: 8px; max-width: 620px; margin: 26px auto 18px; }
      .searchbar input { flex: 1; padding: 14px 16px; border-radius: 10px; border: 1px solid #334155; background: #fff; font-size: 1rem; }
      .searchbar button { padding: 14px 22px; border-radius: 10px; border: 0; background: #0ea5e9; color: #062033; font-weight: 800; font-size: 1rem; cursor: pointer; }
      .stats { display: flex; gap: 26px; justify-content: center; flex-wrap: wrap; color: #94a3b8; font-size: .9rem; }
      .stats strong { color: #fff; }
      .filters { background: #fff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 20; }
      .fwrap { display: flex; gap: 10px; align-items: center; padding: 12px 20px; flex-wrap: wrap; }
      .filters select { padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: .9rem; }
      .result { margin-left: auto; color: #64748b; font-size: .85rem; }
      .body { padding: 38px 20px 80px; }
      h2 { font-size: 1.25rem; margin: 34px 0 14px; color: #0f172a; letter-spacing: -.01em; }
      .statecards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
      .statecard { display: flex; flex-direction: column; gap: 3px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; text-decoration: none; color: #0f172a; }
      .statecard:hover { border-color: #0ea5e9; }
      .statecard span { color: #64748b; font-size: .88rem; }
      .statecard em { color: #0284c7; font-style: normal; font-size: .8rem; font-weight: 700; margin-top: 8px; }
      .catrow { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
      .catchip { display: flex; flex-direction: column; gap: 3px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; text-decoration: none; color: #0f172a; }
      .catchip span { color: #64748b; font-size: .84rem; }
      .sechead { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; flex-wrap: wrap; margin-top: 40px; }
      .sechead h2 { margin: 0; }
      .sechead p { color: #64748b; font-size: .85rem; margin: 0; max-width: 460px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; margin-top: 16px; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; }
      .card:hover { border-color: #cbd5e1; box-shadow: 0 6px 18px rgba(15,23,42,.06); }
      .card-head { display: flex; gap: 12px; align-items: center; }
      .card-head img { width: 44px; height: 44px; object-fit: contain; border-radius: 8px; background: #f8fafc; border: 1px solid #eef2f7; }
      .logo-fallback { width: 44px; height: 44px; border-radius: 8px; background: #e2e8f0; display: grid; place-items: center; font-weight: 800; color: #475569; }
      .card h3 { margin: 0; font-size: 1rem; line-height: 1.25; }
      .card h3 a { color: #0f172a; text-decoration: none; }
      .loc { color: #64748b; font-size: .78rem; margin: 3px 0 0; }
      .desc { color: #475569; font-size: .87rem; line-height: 1.55; margin: 12px 0; flex: 1; }
      .tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
      .tags span { background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; font-size: .68rem; padding: 3px 7px; border-radius: 5px; }
      .card-foot { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 10px; gap: 8px; }
      .view { color: #0284c7; font-size: .82rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
      .badge { font-size: .62rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 800; padding: 3px 7px; border-radius: 4px; white-space: nowrap; }
      .badge.muted { background: #ecfdf5; color: #047857; }
      .badge.paid { background: #0f766e; color: #fff; }
      .empty { color: #64748b; text-align: center; padding: 30px 0; }
      .review-callout { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 44px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px; }
      .review-callout h2 { margin: 0 0 6px; }
      .review-callout p { margin: 0; color: #475569; }
      .btn { display: inline-block; background: #0ea5e9; color: #062033; padding: 12px 20px; border-radius: 8px; font-weight: 800; text-decoration: none; white-space: nowrap; }
      .btn.light { background: #0f172a; color: #fff; }
      .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
      .steps div { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; }
      .steps span { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #e0f2fe; color: #0369a1; font-weight: 800; font-size: .8rem; margin-bottom: 8px; }
      .steps strong { display: block; color: #0f172a; margin-bottom: 4px; }
      .steps p { margin: 0; color: #475569; font-size: .87rem; line-height: 1.55; }
      .claim { margin-top: 44px; background: #0b1220; color: #e2e8f0; border-radius: 16px; padding: 28px; }
      .claim h2 { color: #fff; margin-top: 0; }
      .claim p { color: #b6c2d4; line-height: 1.6; max-width: 640px; }
      .claim-actions { display: flex; gap: 10px; flex-wrap: wrap; margin: 18px 0; }
      .btn.ghost { background: transparent; border: 1px solid #475569; color: #e2e8f0; }
      .fine { font-size: .76rem; color: #8294a9 !important; margin-top: 14px; }
      @media (max-width: 640px) { .result { width: 100%; margin-left: 0; } .hero { padding: 46px 0 30px; } }
    </style>
  </body>
</html>
