---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import directory from '../../data/directory.json';

export function getStaticPaths() {
  const STATE_LABELS = { NSW: 'New South Wales', VIC: 'Victoria', QLD: 'Queensland' };
  const CATEGORY_LABELS = {
    'servicem8-partners': { label: 'ServiceM8 partners', blurb: 'Setup, training, conversions and ongoing support for trade businesses.' },
    'servicem8-developers': { label: 'ServiceM8 developers', blurb: 'Custom add-ons, API integrations and workflow automation built on ServiceM8.' },
    'accountants-bookkeepers': { label: 'Accountants and bookkeepers', blurb: 'Trade-savvy accountants and bookkeepers who also work inside ServiceM8.' },
  };
  const live = directory.listings.filter((l) => l.status === 'live');
  const paths = [];
  for (const code of ['NSW', 'VIC', 'QLD']) {
    const items = live.filter((l) => l.state === code);
    if (items.length < 4) continue;
    paths.push({
      params: { hub: code.toLowerCase() },
      props: {
        kind: 'state',
        heading: `ServiceM8 partners in ${STATE_LABELS[code]}`,
        intro: `${items.length} ServiceM8 partners, developers and trade accountants listed in ${STATE_LABELS[code]}. Compare services and request an introduction.`,
        items,
        key: code.toLowerCase(),
      },
    });
  }
  for (const [key, meta] of Object.entries(CATEGORY_LABELS)) {
    const items = live.filter((l) => l.categories.includes(key));
    if (items.length < 4) continue;
    paths.push({
      params: { hub: key },
      props: {
        kind: 'category',
        heading: `${meta.label} in Australia`,
        intro: `${items.length} ${meta.label.toLowerCase()} listed across NSW, VIC and QLD. ${meta.blurb}`,
        items,
        key,
      },
    });
  }
  return paths;
}

const { kind, heading, intro, items, key } = Astro.props;
const title = `${heading} 2026 | TradieAutomate Directory`;
const description = intro.slice(0, 158);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: heading,
  numberOfItems: items.length,
  itemListElement: items.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: l.name,
    url: `https://tradieautomate.com/directory/partner/${l.slug}/`,
  })),
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Directory', item: 'https://tradieautomate.com/directory/' },
    { '@type': 'ListItem', position: 2, name: heading, item: `https://tradieautomate.com/directory/${key}/` },
  ],
};
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="wrap">
          <nav class="crumbs"><a href="/directory/">Directory</a> / {heading}</nav>
          <h1>{heading}</h1>
          <p>{intro}</p>
        </div>
      </section>

      <div class="wrap body">
        <p class="count">{items.length} providers · verified against ServiceM8's public directory</p>
        <div class="grid">
          {items.map((l) => (
            <article class="card">
              <h2><a href={`/directory/partner/${l.slug}/`}>{l.name}</a></h2>
              <p class="loc">{l.city}, {l.state}</p>
              <p class="sum">{l.summary.slice(0, 165)}…</p>
              <div class="tags">{l.services.slice(0, 3).map((s) => <span>{s}</span>)}</div>
              <a class="more" href={`/directory/partner/${l.slug}/`}>View profile →</a>
            </article>
          ))}
        </div>

        <section class="claim">
          <h2>Is your business listed?</h2>
          <p>Basic listings are free. Claim yours to correct details and receive introduction requests from tradies in your area.</p>
          <a class="btn" href="mailto:info@tradieautomate.com?subject=Claim%20my%20directory%20listing&body=Business%20name%3A%0AState%3A%0AWebsite%3A%0A">Claim your listing</a>
        </section>

        <p class="fine">
          TradieAutomate is independent and not endorsed by ServiceM8. Compiled from ServiceM8's public partner and
          developer directories. Outbound links are nofollow.
        </p>
      </div>
    </main>
    <Footer />
    <style>
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      .hero { background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); color: #e2e8f0; padding: 44px 0 36px; }
      .crumbs { font-size: .8rem; color: #94a3b8; margin-bottom: 10px; }
      .crumbs a { color: #38bdf8; text-decoration: none; }
      .hero h1 { color: #fff; font-size: clamp(1.6rem, 3.6vw, 2.3rem); margin: 0 0 10px; }
      .hero p { color: #94a3b8; max-width: 680px; line-height: 1.6; }
      .body { padding: 34px 20px 70px; }
      .count { color: #64748b; font-size: .85rem; margin-bottom: 14px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; }
      .card h2 { font-size: 1.02rem; margin: 0 0 4px; }
      .card h2 a { color: #0f172a; text-decoration: none; }
      .loc { color: #64748b; font-size: .8rem; margin: 0 0 8px; }
      .sum { color: #475569; font-size: .88rem; line-height: 1.5; }
      .tags { display: flex; gap: 6px; flex-wrap: wrap; margin: 10px 0; }
      .tags span { background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; font-size: .7rem; padding: 3px 7px; border-radius: 5px; }
      .more { color: #0284c7; font-size: .85rem; font-weight: 700; text-decoration: none; }
      .claim { margin-top: 40px; background: #0f172a; color: #e2e8f0; border-radius: 14px; padding: 26px; }
      .claim h2 { color: #fff; margin-top: 0; font-size: 1.2rem; }
      .claim p { color: #cbd5e1; }
      .btn { display: inline-block; background: #0ea5e9; color: #062033; padding: 11px 18px; border-radius: 8px; font-weight: 700; text-decoration: none; }
      .fine { color: #64748b; font-size: .78rem; margin-top: 18px; line-height: 1.6; }
    </style>
  </body>
</html>
