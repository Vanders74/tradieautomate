---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = 'Electrical Award Rates Quick Reference Card 2026 — Free PDF';
const description = 'Free 1-page PDF: MA000025 electrical award rates July 2026. Grades 1–5, apprentice Year 1–4, overtime, tool allowance, industry allowance. Updated for Fair Work July 2026 determination.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .lead-page {
        max-width: 680px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      .badge {
        display: inline-block;
        background: #f59e0b;
        color: #1a2744;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.35em 0.9em;
        border-radius: 99px;
        margin-bottom: 1.2rem;
      }

      h1 {
        font-size: 2.2rem;
        line-height: 1.15;
        color: #1a2744;
        margin: 0 0 1rem;
      }

      h1 span {
        color: #f59e0b;
      }

      .sub {
        font-size: 1.1rem;
        color: #4b5563;
        margin-bottom: 2rem;
        line-height: 1.6;
      }

      .pdf-preview {
        background: #f0f4ff;
        border: 2px solid #dde4f0;
        border-radius: 12px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
      }

      .pdf-icon {
        font-size: 3rem;
        flex-shrink: 0;
        line-height: 1;
      }

      .pdf-meta {
        flex: 1;
      }

      .pdf-meta strong {
        display: block;
        font-size: 1rem;
        color: #1a2744;
        margin-bottom: 0.3rem;
      }

      .pdf-meta ul {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
        font-size: 0.9rem;
        color: #374151;
      }

      .pdf-meta ul li {
        padding: 0.2rem 0;
      }

      .pdf-meta ul li::before {
        content: '✓ ';
        color: #16a34a;
        font-weight: 700;
      }

      /* Gated form box */
      .form-box {
        background: #1a2744;
        border-radius: 12px;
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
      }

      .form-box h2 {
        font-size: 1.3rem;
        margin: 0 0 0.5rem;
        color: white;
      }

      .form-box .form-desc {
        font-size: 0.95rem;
        color: #b0bed4;
        margin: 0 0 1.5rem;
      }

      .form-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
      }

      .form-field {
        flex: 1;
        min-width: 140px;
      }

      .form-field label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #94a3b8;
        margin-bottom: 0.3rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .form-field input {
        width: 100%;
        padding: 0.65rem 0.9rem;
        border: 1.5px solid rgba(255,255,255,0.15);
        border-radius: 6px;
        background: rgba(255,255,255,0.07);
        color: white;
        font-size: 1rem;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.2s;
      }

      .form-field input:focus {
        border-color: #f59e0b;
      }

      .form-field input::placeholder {
        color: rgba(255,255,255,0.35);
      }

      .submit-btn {
        display: block;
        width: 100%;
        padding: 0.9rem 1.5rem;
        background: #f59e0b;
        color: #1a2744;
        border: none;
        border-radius: 8px;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
        margin-top: 1rem;
        text-align: center;
      }

      .submit-btn:hover:not(:disabled) {
        background: #d97706;
        transform: translateY(-1px);
      }

      .submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }

      .form-error {
        color: #fca5a5;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: none;
      }

      .privacy {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 0.75rem;
        text-align: center;
      }

      /* Download reveal box */
      .download-reveal {
        display: none;
        text-align: center;
        padding: 2rem;
        background: #f0fdf4;
        border: 2px solid #bbf7d0;
        border-radius: 12px;
        margin-bottom: 2rem;
      }

      .download-reveal.visible {
        display: block;
      }

      .download-reveal p {
        color: #15803d;
        font-weight: 600;
        margin: 0 0 1rem;
        font-size: 1rem;
      }

      .download-btn {
        display: inline-block;
        background: #16a34a;
        color: white;
        text-decoration: none;
        padding: 0.9rem 2rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: background 0.2s;
      }

      .download-btn:hover {
        background: #15803d;
      }

      .trust-strip {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
      }

      .trust-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: #6b7280;
      }

      .trust-item .icon {
        font-size: 1rem;
      }

      .content-section {
        margin-top: 3rem;
        border-top: 2px solid #e5e7eb;
        padding-top: 2rem;
      }

      .content-section h2 {
        font-size: 1.4rem;
        color: #1a2744;
        margin-bottom: 0.75rem;
      }

      .content-section p {
        color: #374151;
        line-height: 1.7;
        margin-bottom: 1rem;
      }

      .rates-sample {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
        overflow-x: auto;
      }

      .rates-sample table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }

      .rates-sample th {
        text-align: left;
        padding: 0.4rem 0.75rem;
        background: #1a2744;
        color: white;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .rates-sample td {
        padding: 0.4rem 0.75rem;
        border-bottom: 1px solid #e2e8f0;
        color: #374151;
      }

      .rates-sample tr:last-child td {
        border-bottom: none;
      }

      @media (max-width: 600px) {
        h1 { font-size: 1.7rem; }
        .pdf-preview { flex-direction: column; }
        .form-row { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="lead-page">

        <div class="badge">Free Download</div>

        <h1>Electrical Award Rates<br /><span>Quick Reference Card 2026</span></h1>

        <p class="sub">
          The MA000025 rates you actually need — Grades 1–5, apprentice Year 1–4, overtime,
          tool allowance, and industry allowance — on one printable page. Updated for the
          Fair Work Commission's July 2026 Annual Wage Review determination.
        </p>

        <!-- PDF Preview -->
        <div class="pdf-preview">
          <div class="pdf-icon">⚡</div>
          <div class="pdf-meta">
            <strong>MA000025 Award Rates Quick Reference Card — July 2026</strong>
            <p style="color:#4b5563;font-size:0.9rem;margin:0.25rem 0 0.5rem;">A4 · Printable · 1 page · Free</p>
            <ul>
              <li>ET Grades 1–5 — base hourly rates effective 1 July 2026</li>
              <li>Apprentice Year 1–4 — hourly rates at correct MA000025 percentages</li>
              <li>Overtime — 1.5x and 2x rates pre-calculated per grade</li>
              <li>Tool allowance and industry allowance (updated July 2026)</li>
              <li>Super guarantee rate — 11.5% from 1 July 2025</li>
            </ul>
          </div>
        </div>

        <!-- Gated email capture form -->
        <div class="form-box" id="capture-form-box">
          <h2>Enter your email to get instant access</h2>
          <p class="form-desc">Free PDF download — we'll also send you an update when Fair Work publishes the next Annual Wage Review.</p>

          <form id="award-rates-form" novalidate>
            <div class="form-row">
              <div class="form-field">
                <label for="firstName">First Name</label>
                <input type="text" id="firstName" name="firstName" placeholder="Your first name" autocomplete="given-name" />
              </div>
              <div class="form-field">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" />
              </div>
            </div>
            <div class="form-error" id="form-error"></div>
            <button type="submit" class="submit-btn" id="submit-btn">
              Get Free PDF →
            </button>
          </form>

          <p class="privacy">No spam. Unsubscribe anytime. Australian Privacy Act compliant.</p>
        </div>

        <!-- Download revealed after form submit -->
        <div class="download-reveal" id="download-reveal">
          <p>✅ You're in! Your reference card is ready to download.</p>
          <a class="download-btn" id="download-link" href="/electrical-award-rates-card-2026.pdf" download="MA000025-Award-Rates-Quick-Reference-2026-TradieAutomate.pdf">
            Download PDF Reference Card →
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="trust-strip">
          <div class="trust-item">
            <span class="icon">🇦🇺</span>
            <span>MA000025 — Australian award</span>
          </div>
          <div class="trust-item">
            <span class="icon">📅</span>
            <span>Updated July 2026</span>
          </div>
          <div class="trust-item">
            <span class="icon">🔒</span>
            <span>No credit card required</span>
          </div>
        </div>

        <!-- Supporting content -->
        <div class="content-section">
          <h2>What's in the Reference Card</h2>
          <p>
            Electricians searching for MA000025 award rates typically need one thing: the number.
            Not a 3,000-word guide — the exact rate for the grade they're hiring, right now, with
            overtime pre-calculated so they can quote a week's labour without opening a spreadsheet.
          </p>
          <p>
            The Quick Reference Card gives you that in one printable page:
          </p>

          <div class="rates-sample">
            <table>
              <thead>
                <tr>
                  <th>Classification</th>
                  <th>Hourly (Ord)</th>
                  <th>OT 1.5x</th>
                  <th>OT 2x</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>ET Grade 1</td><td>$38.43</td><td>$57.65</td><td>$76.86</td></tr>
                <tr><td>ET Grade 2</td><td>$39.36</td><td>$59.04</td><td>$78.72</td></tr>
                <tr><td>ET Grade 3</td><td>$40.26</td><td>$60.39</td><td>$80.52</td></tr>
                <tr><td>ET Grade 4</td><td>$41.20</td><td>$61.80</td><td>$82.40</td></tr>
                <tr><td>ET Grade 5</td><td>$42.15</td><td>$63.23</td><td>$84.30</td></tr>
                <tr><td>Apprentice Yr 1 (42%)</td><td>$16.14</td><td>$24.21</td><td>$32.28</td></tr>
                <tr><td>Apprentice Yr 2 (55%)</td><td>$21.14</td><td>$31.71</td><td>$42.28</td></tr>
                <tr><td>Apprentice Yr 3 (75%)</td><td>$28.82</td><td>$43.23</td><td>$57.64</td></tr>
                <tr><td>Apprentice Yr 4 (88%)</td><td>$33.82</td><td>$50.73</td><td>$67.64</td></tr>
              </tbody>
            </table>
          </div>

          <p>
            The full card also includes the tool allowance ($21.17/week for employee-supplied tools),
            industry allowance, and the current 11.5% superannuation guarantee rate — everything
            you need to cost a week's labour accurately.
          </p>

          <h2>Why Fair Work Audits Are a Real Risk in 2026</h2>
          <p>
            The Fair Work Ombudsman has been actively auditing the trades sector. Underpaying by
            even $1/hour — on the wrong classification, missing an allowance, or using outdated
            rates — creates backpay liability stretching up to 6 years under the Fair Work Act.
          </p>
          <p>
            The most common errors we see: paying Grade 1 rates to Grade 3 tradespeople, not applying
            the tool allowance when employees supply their own tools, and continuing to use pre-July
            pay rates after the annual Fair Work determination takes effect.
          </p>
          <p>
            For the full classification guide, overtime rules, and an interactive pay calculator, see our
            <a href="/blog/electrical-contractor-award-rates-australia-2026">Electrical Award Rates 2026 Guide</a>.
          </p>

          <h2>Want to Run MA000025 Payroll Without the Spreadsheet?</h2>
          <p>
            See our <a href="/blog/xero-vs-myob-accounting-software-australian-tradies-2026">Xero vs MYOB comparison for Australian trade businesses</a>
            — including which platform handles MA000025 payroll better for businesses with
            multiple apprentices and tradespeople.
          </p>
        </div>

      </div>
    </main>
    <Footer />

    <script>
      const form = document.getElementById('award-rates-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const formError = document.getElementById('form-error') as HTMLElement;
      const captureBox = document.getElementById('capture-form-box') as HTMLElement;
      const downloadReveal = document.getElementById('download-reveal') as HTMLElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.style.display = 'none';
        formError.textContent = '';

        const emailInput = document.getElementById('email') as HTMLInputElement;
        const firstNameInput = document.getElementById('firstName') as HTMLInputElement;
        const email = emailInput.value.trim();
        const firstName = firstNameInput.value.trim();

        if (!email || !email.includes('@')) {
          formError.textContent = 'Please enter a valid email address.';
          formError.style.display = 'block';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';

        try {
          const res = await fetch('/.netlify/functions/award-rates-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, firstName }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            captureBox.style.display = 'none';
            downloadReveal.classList.add('visible');
            const link = document.createElement('a');
            link.href = data.downloadUrl || '/electrical-award-rates-card-2026.pdf';
            link.download = 'MA000025-Award-Rates-Quick-Reference-2026-TradieAutomate.pdf';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
          } else {
            formError.textContent = data.error || 'Something went wrong. Please try again.';
            formError.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Get Free PDF →';
          }
        } catch (err) {
          formError.textContent = 'Network error. Please try again.';
          formError.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Get Free PDF →';
        }
      });
    </script>
  </body>
</html>
