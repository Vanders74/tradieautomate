---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';

const title = "Tradie Admin Cost Calculator — See What Paperwork Is Costing You";
const description = "Free calculator for Australian electricians. See exactly how much your admin overhead costs per year — quoting, invoicing, scheduling, and chasing payments. Takes 60 seconds.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; line-height: 1.6; }
      .page { max-width: 680px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }

      .logo { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; color: #f97316; margin-bottom: 2.5rem; }

      .badge { display: inline-block; background: #f97316; color: #fff; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3em 0.8em; border-radius: 99px; margin-bottom: 1.2rem; }

      h1 { font-size: 2rem; line-height: 1.2; color: #ffffff; margin-bottom: 0.8rem; }
      h1 span { color: #f97316; }

      .sub { font-size: 1.05rem; color: #94a3b8; margin-bottom: 2rem; }

      .stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem; }
      .stat-box { background: #1e293b; border-radius: 10px; padding: 1.2rem; text-align: center; }
      .stat-box .number { font-size: 1.8rem; font-weight: 800; color: #f97316; display: block; }
      .stat-box .label { font-size: 0.78rem; color: #94a3b8; margin-top: 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; }

      .problem-list { margin-bottom: 2rem; padding: 0; list-style: none; }
      .problem-list li { padding: 0.3rem 0 0.3rem 1.5rem; position: relative; color: #cbd5e1; font-size: 0.95rem; }
      .problem-list li::before { content: '✗'; position: absolute; left: 0; color: #ef4444; font-weight: 700; }

      .form-box {
        background: #1e293b;
        border: 1.5px solid #334155;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
      }

      .form-box h2 { font-size: 1.2rem; color: #ffffff; margin-bottom: 0.5rem; }
      .form-box .form-desc { font-size: 0.9rem; color: #94a3b8; margin-bottom: 1.5rem; }

      .form-field { margin-bottom: 1rem; }
      .form-field label { display: block; font-size: 0.78rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .form-field input {
        width: 100%;
        padding: 0.7rem 0.9rem;
        border: 1.5px solid #334155;
        border-radius: 6px;
        background: #0f172a;
        color: #e2e8f0;
        font-size: 0.95rem;
      }
      .form-field input:focus { outline: none; border-color: #f97316; }

      .btn-primary {
        display: inline-block;
        width: 100%;
        padding: 0.8rem 1.5rem;
        background: #f97316;
        color: #ffffff;
        font-weight: 700;
        font-size: 1rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
      }
      .btn-primary:hover { background: #ea6b0e; }
      .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

      .success-box {
        display: none;
        background: #1e293b;
        border: 1.5px solid #22c55e;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        text-align: center;
      }
      .success-box h2 { color: #22c55e; font-size: 1.2rem; margin-bottom: 0.5rem; }
      .success-box p { color: #94a3b8; font-size: 0.95rem; margin-bottom: 1rem; }

      .error-msg { color: #ef4444; font-size: 0.85rem; margin-top: 0.5rem; display: none; }

      .privacy { font-size: 0.78rem; color: #64748b; margin-top: 1rem; text-align: center; }
      .privacy a { color: #94a3b8; }

      @media (max-width: 480px) {
        .page { padding: 1.5rem 1rem 2rem; }
        h1 { font-size: 1.6rem; }
        .stat-row { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="logo">⚡ TradieAutomate</div>

      <div class="badge">Free Tool</div>

      <h1>Still doing quotes on paper? <br><span>Here's what it's costing you.</span></h1>
      <p class="sub">The average sparky spends 8-12 hours a week on admin. At $120/hr, that's over $60K a year in non-billable time. Run your numbers in 60 seconds.</p>

      <div class="stat-row">
        <div class="stat-box">
          <span class="number">8-12</span>
          <span class="label">Hours/week on admin</span>
        </div>
        <div class="stat-box">
          <span class="number">$62,400</span>
          <span class="label">Annual admin cost (avg)</span>
        </div>
      </div>

      <ul class="problem-list">
        <li>Writing quotes at night instead of with family</li>
        <li>Chasing unpaid invoices 30-60 days late</li>
        <li>Re-entering job details across 3 different apps</li>
        <li>Compliance forms done manually after every install</li>
      </ul>

      <!-- Gated form -->
      <div class="form-box" id="formBox">
        <h2>See your numbers</h2>
        <p class="form-desc">Enter your details. We'll send you the admin cost calculator — free, no catch, takes 60 seconds.</p>
        <form id="leadForm">
          <div class="form-field">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" name="firstName" placeholder="Dave" autocomplete="given-name" required />
          </div>
          <div class="form-field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" placeholder="dave@yourelectrical.com.au" autocomplete="email" required />
          </div>
          <button type="submit" class="btn-primary" id="submitBtn">Get My Numbers →</button>
          <div class="error-msg" id="errorMsg"></div>
        </form>
        <p class="privacy">Your email is only used to send the calculator. <a href="/privacy">Privacy</a></p>
      </div>

      <!-- Success state -->
      <div class="success-box" id="successBox">
        <h2>✅ Calculator on its way</h2>
        <p>Check your inbox in the next 2-3 minutes.</p>
        <p style="font-size:0.85rem;color:#94a3b8">Electricians using job management software cut admin by 4-6 hours a week. <br><a href="https://www.servicem8.com/au/free-trial/?ref=tradieautomate&utm_source=tradieautomate&utm_medium=email&utm_campaign=email_outreach_electrical&utm_content=download_ty" target="_blank" rel="nofollow sponsored" style="color:#f97316;font-weight:600">See how ServiceM8 automates the paperwork →</a></p>
      </div>

      <Footer />
    </div>

    <script>
      const form = document.getElementById('leadForm');
      const formBox = document.getElementById('formBox');
      const successBox = document.getElementById('successBox');
      const errorMsg = document.getElementById('errorMsg');
      const submitBtn = document.getElementById('submitBtn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        errorMsg.style.display = 'none';

        const firstName = document.getElementById('firstName').value.trim();
        const email = document.getElementById('email').value.trim();

        try {
          const resp = await fetch('/.netlify/functions/electrical-outreach-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ firstName, email }),
          });

          if (resp.ok) {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'lead_magnet_download', {
                event_category: 'email_outreach',
                event_label: 'admin_cost_calculator',
                campaign: 'email_outreach_electrical',
              });
            }
            formBox.style.display = 'none';
            successBox.style.display = 'block';
          } else {
            const data = await resp.json().catch(() => ({}));
            throw new Error(data.error || 'Something went wrong');
          }
        } catch (err) {
          errorMsg.textContent = err.message || 'Something went wrong. Please try again.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Get My Numbers →';
        }
      });
    </script>
  </body>
</html>
